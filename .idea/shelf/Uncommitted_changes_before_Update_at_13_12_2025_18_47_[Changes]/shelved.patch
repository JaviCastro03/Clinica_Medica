 \r\n    line-height: 1; \r\n    animation: glow 2.5s infinite ease-in-out; \r\n    border-radius: 50%; \r\n    padding: 10px; \r\n}\r\n\r\n.cta-icon span img {\r\n    height: 90px; \r\n    width: auto;\r\n    display: block; \r\n    object-fit: contain; \r\n}\r\n\r\n@keyframes glow {\r\n    0% { \r\n        box-shadow: 0 0 8px rgba(255, 255, 255, 0.4), 0 0 15px var(--color-green); \r\n        transform: scale(1);\r\n    }\r\n    50% { \r\n        box-shadow: 0 0 15px rgba(255, 255, 255, 0.7), 0 0 30px var(--color-green); \r\n        transform: scale(1.03); /* Ligeramente más grande */\r\n    }\r\n    100% { \r\n        box-shadow: 0 0 8px rgba(255, 255, 255, 0.4), 0 0 15px var(--color-green); \r\n        transform: scale(1);\r\n    }\r\n}\r\n\r\n.cta-section__title {\r\n    color: var(--color-white);\r\n    font-size: 2.8rem; \r\n    margin-bottom: 15px;\r\n    font-weight: 700;\r\n}\r\n\r\n.cta-section__subtitle {\r\n    font-size: 1.2rem;\r\n    color: var(--color-transition1); \r\n    margin-bottom: 40px;\r\n    max-width: 700px;\r\n    margin-left: auto;\r\n    margin-right: auto;\r\n}\r\n\r\n.stepper-wrapper {\r\n    margin-top: auto;\r\n    display: flex;\r\n    justify-content: space-between;\r\n    margin-bottom: 20px;\r\n}\r\n.stepper-item {\r\n    position: relative;\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n    flex: 1;\r\n\r\n    @media (max-width: 768px) {\r\n        font-size: 12px;\r\n    }\r\n}\r\n\r\n.stepper-item::before {\r\n    position: absolute;\r\n    content: \"\";\r\n    border-bottom: 2px solid #ccc;\r\n    width: 100%;\r\n    top: 20px;\r\n    left: -50%;\r\n    z-index: 2;\r\n}\r\n\r\n.stepper-item::after {\r\n    position: absolute;\r\n    content: \"\";\r\n    border-bottom: 2px solid #ccc;\r\n    width: 100%;\r\n    top: 20px;\r\n    left: 50%;\r\n    z-index: 2;\r\n}\r\n\r\n.stepper-item .step-counter {\r\n    position: relative;\r\n    z-index: 5;\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    width: 40px;\r\n    height: 40px;\r\n    border-radius: 50%;\r\n    background: #ccc;\r\n    margin-bottom: 6px;\r\n}\r\n\r\n.stepper-item.active {\r\n    font-weight: bold;\r\n}\r\n\r\n.stepper-item.completed .step-counter {\r\n    background-color: var(--color-blue-soft);\r\n    color: white;\r\n}\r\n\r\n.stepper-item.completed::after {\r\n    position: absolute;\r\n    content: \"\";\r\n    border-bottom: 2px solid var(--color-blue-soft);\r\n    width: 100%;\r\n    top: 20px;\r\n    left: 50%;\r\n    z-index: 3;\r\n}\r\n\r\n.stepper-item:first-child::before {\r\n    content: none;\r\n}\r\n.stepper-item:last-child::after {\r\n    content: none;\r\n}\r\n\r\n.tabla{\r\n    width: 100%;\r\n    border-collapse: separate;\r\n    border-spacing: 0;\r\n    border-radius: 6px;\r\n    overflow: hidden;\r\n    height: 7rem;\r\n    border: 1px solid var(--color-blue-soft);\r\n    table-layout: fixed;\r\n\r\n}\r\n\r\n\r\n\r\n.tabla th{\r\n    padding: 0.6rem;\r\n    background-color: var(--color-blue-soft);\r\n    color: white;\r\n    border-bottom: var(--color-white);\r\n    overflow-wrap: break-word;\r\n\r\n}\r\n.tabla td{\r\n    padding: 0.6rem;\r\n    overflow-wrap: break-word;\r\n}\r\n\r\n.tabla td button {\r\n    margin: 0 auto;\r\n    display: block;\r\n}\r\n\r\n\r\n.tabla tr:nth-child(even) {\r\n    background: var(--color-white);\r\n}\r\n\r\n.tabla tr:nth-child(odd) {\r\n    background: var(--color-border);\r\n}\r\n.button-table:hover {\r\n    box-shadow: 0px 0px 5px var(--color-text-grey),\r\n    0px 0px 15px #ffffff;\r\n}\r\n.div__button-table{\r\n    display: flex;\r\n    flex-direction: row;\r\n    padding: 2rem 0;\r\n}\r\n.div__button-container{\r\n    display: grid;\r\n    grid-template-columns: 1fr 8fr 1fr;\r\n}\r\n\r\n.grid-1{\r\n    order: 3;\r\n}\r\n.grid-2{\r\n    order: 2;\r\n}\r\n.grid-3{\r\n    order: 1;\r\n}\r\n.input-date{\r\n    width: 30%;\r\n    padding: 1rem;\r\n    font-size: 20px;\r\n    text-align: c