+    margin: 10px auto;
+    text-align: center;
+    background: none;
+    border: none;
+    font-size: 1em;
+    font-weight: 500;
+    padding: 5px 0;
+    cursor: pointer;
+    color: var(--color-blue-dark);
+}
+
+.formulario-login .nav__auth-link:hover {
+    color: var(--color-blue-soft);
+    text-decoration: underline;
+}
+
+.cita-info {
+    display: flex;
+    justify-content: center;
+    text-align: center;
+    width: 100%;
+}
+
+.task {
+    max-width: 400px;
+    width: 100%;
+    margin: 0 auto;
+    text-align: center;
+    background-color: var(--color-white);
+    border-radius: 12px;
+}
+
+.task-header {
+    color: var(--color-blue-hard);
+    margin-bottom: 1.5rem;
+    font-size: 1.8rem;
+    font-weight: 600;
+}
+.btn--medium {
+    padding: 10px 25px;
+    font-size: 1em;
+    border-radius: 6px;
+    font-weight: 600;
+}
+
+@media (max-width: 576px) {
+    .task {
+        width: 95%;
+        padding: 1rem;
+    }
+    .btn--large {
+        padding: 12px 20px;
+        font-size:1em;
