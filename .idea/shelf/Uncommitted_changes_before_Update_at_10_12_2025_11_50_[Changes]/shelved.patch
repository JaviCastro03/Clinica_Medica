te);\r\n        font-size: 6px;\r\n        padding: 6px;\r\n    }\r\n    .input-date{\r\n        font-size: 12px;\r\n        padding: 0.6rem;\r\n    }\r\n}\r\n\r\n/* ----------------------------------- */\r\n/* 11. FOOTER */\r\n/* ----------------------------------- */\r\n.footer {\r\n    text-align: center;\r\n    padding: 25px 5%;\r\n    background-color: var(--color-white);\r\n    color: var(--color-text-grey);\r\n    font-size: 0.9em;\r\n    border-top: 1px solid var(--color-border);\r\n}\r\n\r\n.footer__text {\r\n    font-size: 0.9em;\r\n}\r\n
