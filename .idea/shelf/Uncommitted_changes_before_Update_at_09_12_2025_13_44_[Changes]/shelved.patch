 {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 8px;\r\n  margin: 0;\r\n  position: relative;   \r\n}\r\n\r\n.button span {\r\n  position: absolute;\r\n  left: 0;\r\n  transition: opacity 0.2s ease;\r\n}\r\n\r\n.button .wrap p::before {\r\n  content: \"\";\r\n  display: inline-block;\r\n  width: 18px;\r\n  height: 1px;\r\n}\r\n\r\n.button:hover {\r\n  box-shadow: 0px 0px 5px var(--color-text-grey),\r\n              -9px -9px 33px #ffffff;\r\n}\r\n.table-flex{\r\n    display: flex;\r\n\r\n}\r\n.button span:nth-child(1) {\r\n  opacity: 1;\r\n}\r\n\r\n.button span:nth-child(2) {\r\n  opacity: 0;\r\n}\r\n\r\n.button:hover span:nth-child(1) {\r\n  opacity: 0;\r\n}\r\n\r\n.button:hover span:nth-child(2) {\r\n  opacity: 1;\r\n}\r\n\r\n\r\n.button-table {\r\n    display: flex;\r\n    height: 1.8rem;\r\n    min-width: 6rem;\r\n    text-align: center;\r\n    align-items: center;\r\n    justify-content: center;\r\n    border-radius: 6px;\r\n    letter-spacing: 1px;\r\n    transition: all 0.25s linear;\r\n    cursor: pointer;\r\n    border: none;\r\n    background: var(--color-green);\r\n    color: var(--color-white);\r\n    font-size: 0.9rem;\r\n}\r\n.button-table:hover {\r\n    box-shadow: 0px 0px 5px var(--color-text-grey),\r\n    -9px -9px 33px #ffffff;\r\n}\r\n\r\n\r\n/* ----------------------------------- */\r\n/* 5. VIDEO */\r\n/* ----------------------------------- */\r\n\r\n.video-background {\r\n    position: relative;\r\n    width: 100%;\r\n    height: 100vh;\r\n    overflow: hidden;\r\n}\r\n\r\n/* Video */\r\n#background-video {\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    width: 100%;\r\n    height: 100%;\r\n    object-fit: cover;\r\n    z-index: 1;\r\n}\r\n\r\n.video-overlay {\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    width: 100%;\r\n    height: 100%;\r\n    background: linear-gradient(\r\n        180deg,\r\n        rgba(0, 0, 0, 0.45) 0%,\r\n        rgba(0, 0, 0, 0.75) 100%\r\n   