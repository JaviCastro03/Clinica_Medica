n        $dni = $_POST['dni'];\r\n        $nombre = $_POST['nombre'];\r\n        $apellidos = $_POST['apellidos'];\r\n        $email = $_POST['email'];\r\n        $rol = $_POST['rol'];\r\n        $telefono = $_POST['telefono'];\r\n        $direccion = $_POST['direccion'];\r\n        $cp = $_POST['cp'];\r\n        $password= $_POST['password'];\r\n\r\n        if($dni=='' || $nombre=='' || $apellidos=='' || $email=='' || $telefono=='' || $direccion=='' || $cp=='' || $password=='' || $rol==''){\r\n            $_SESSION[\"mensaje\"] = \"<p class='mensaje-error'>Todos los campos son obligatorios</p>\";\r\n        }\r\n        else{\r\n            $hash = password_hash($password, PASSWORD_DEFAULT);\r\n            $usuario = new Usuario($dni, $apellidos, $nombre, $email, $hash, $direccion,$telefono,$cp,$rol);\r\n            if($conexion->insertarUsuario($usuario)){\r\n                $_SESSION[\"mensaje\"] = \"<p class='mensaje-exito'>Usuario insertado correctamente</p>\";\r\n            }else{\r\n                $_SESSION[\"mensaje\"] = \"<p class='mensaje-error'>Error al insertar el usuario</p>\";\r\n            }\r\n        }\r\n\r\n\r\n        header(\"Location:index.php\");\r\n        exit();\r\n\r\n\r\n    }\r\n    if(isset($_POST['guardar'])){\r\n        $id=$_POST[\"id\"];\r\n        $dni = $_POST['dni'];\r\n        $nombre = $_POST['nombre'];\r\n        $apellidos = $_POST['apellidos'];\r\n        $email = $_POST['email'];\r\n        $rol = $_POST['rol'];\r\n        $telefono = $_POST['telefono'];\r\n        $direccion = $_POST['direccion'];\r\n        $cp = $_POST['cp'];\r\n\r\n\r\n        if($conexion->updateUsuariosAdmin($id,$dni,$nombre,$apellidos,$email,$rol,$telefono,$direccion,$cp)){\r\n\r\n            if($rol==3){\r\n                $conexionMedico->actualizarDatosMedico($apellidos,$nombre,$id,$direccion,$telefono,$cp);\r\n            }\r\n            $_SESSION[\"mensaje\"] = \"<p class='mensaje-exito'>Usuario actualizado correctamente</p>\";\r\n\r\n            \r\n\r\n        }\r\n        else{\r\n            $_SESSION[\"mensaje\"] = \"<p class='mensaje-error'>Error al actualizar el usuario</p>>\";\r\n        }\r\n\r\n\r\n\r\n        header(\"Location: index.php\");\r\n        exit();\r\n\r\n    }\r\n    if(isset($_POST['eliminar'])){\r\n        $id=$_POST[\"id\"];\r\n        $rol = $conexion->getRol($id);\r\n\r\n        if($rol==3){\r\n            $conexionMedico->eliminarMedico($id);\r\n        }\r\n        if($conexion->eliminarUsuario($id)){\r\n            $_SESSION[\"mensaje\"] = \"<p class='mensaje-exito'>Usuario eliminado correctamente </p>\";\r\n        }\r\n        else{\r\n            $_SESSION[\"mensaje\"] = \"<p class='mensaje-error'>Error al eliminar el usuario</p>\";\r\n        }\r\n        header(\"Location: index.php\");\r\n        exit();\r\n    }\r\n\r\n    if(isset($_POST['buscar'])){\r\n        $consulta = $conexion->getUsuariosAdmin($_POST['email']);\r\n    }\r\n    else{\r\n        $consulta = $conexion->getUsuariosAdmin(\"\");\r\n    }\r\n\r\n\r\n    require_once \"./views/vistaUsuariosAdmin.php\";\r\n}\r\n\r\nif($_SESSION[\"ruta\"] == \"medicosAdmin\"){\r\n\r\n    if(isset($_POST['guardar'])){\r\n        $id=$_POST[\"id\"];\r\n        $especialidad = $_POST['especialidadM'];\r\n        if($conexionMedico->setEspecialidad($id,$especialidad)){\r\n            $_SESSION['mensaje'] = \"<p class='mensaje-exito'>Especialidad actualizada correctamente</p>\";\r\n        }\r\n        else{\r\n            $_SESSION['mensaje'] = \"<p class='mensaje-error'>Error al actualizar la especialidad</p>\";\r\n        }\r\n        header(\"Location: index.php\");\r\n        exit();\r\n    }\r\n    if(isset($_POST['eliminar'])){\r\n        $id=$_POST[\"id\"];\r\n        if($conexionMedico->eliminarMedico($id)){\r\n            $_SESSION[\"mensaje\"] = \"<p class='mensaje-exito'>Médico eliminado correctamente</p>\";\r\n        }\r\n        else{\r\n            $_SESSION[\"mensaje\"] = \"<p class='mensaje-error'>Error al eliminar el médico</p>>\";\r\n        }\r\n        header(\"Location: index.php\");\r\n        exit();\r\n    }\r\n    if(isset($_POST['buscar'])){\r\n        $consulta = $conexionMedico->getMedicosAdmin($_POST['email']);\r\n    }\r\n    else{\r\n        $consulta = $conexionMedico->getMedicosAdmin(\"\");\r\n    }\r\n\r\n    $especialidades=$conexionMedico->getEspecialidades();\r\n\r\n    if(isset($_POST['addMedico'])){\r\n        $email=$_POST['email'];\r\n        if(!$conexion->emailExiste($email)){\r\n            $_SESSION[\"mensaje\"] = \"<p class='mensaje-error'>Este email no está registrado</p>\";\r\n\r\n        }\r\n        else{\r\n            $id=$conexion->getIDUsuario($email);\r\n\r\n            $usuario = $conexion->getInfoUsuario($id);\r\n            $fila = $usuario->fetch(PDO::FETCH_ASSOC);\r\n            $conexion->setRol($email,3);\r\n            $conexionMedico->insertarMedico($fila['id'],$fila['dni'],$fila['nombre'],$fila['apellidos'],$fila['email'],$fila['password'],3,$_POST['especialidad'],$fila['telefono'],$fila['direccion'],$fila['cp']);\r\n\r\n\r\n        }\r\n        header(\"Location: index.php\");\r\n        exit();\r\n    }\r\n    require_once \"./views/vistaMedicosAdmin.php\";\r\n}\r\n\r\nif ($_SESSION[\"ruta\"] == \"usuarioMedico\") {\r\n\r\n    $consulta = $conexion->getInfoUsuario($idU);\r\n    require_once \"./views/vistaUsuarioMedico.php\";\r\n\r\n\r\n\r\n}\r\n\r\n//Editar información del usuario\r\nif ($_SESSION[\"ruta\"] == \"editarUsuario\") {\r\n\r\n    if (isset($_POST[\"cambiarPassword\"])) {\r\n        $token = hash('sha512', rand(1, 15000));\r\n        $mensaje = \"Has recibido este correo porque has solicitado cambiar tu contraseña, \r\n            pincha en el siguiente enlace para confirmar tu cambio de contraseña: http://localhost/clinica/controllers/verificar/cambiarPassword.php?email=\".$conexion->getEmail($idU).\"&token=\".$token;\r\n        if (enviarCorreoGmail($conexion->getEmail($idU), \"Cambio de contraseña\", $mensaje)) {\r\n            $_SESSION['mensaje'] = '<script>alert(\"Correo enviado para verificar el cambio de contraseña\")</script>';\r\n        } else {\r\n            $_SESSION['mensaje'] = '<script>alert(\"No se pudo enviar el correo de verificación, intentalo más tarde\")</script>';\r\n        }\r\n    }\r\n\r\n    if(isset($_POST[\"cambiarEmail\"])){\r\n        $token = hash('sha512', rand(1, 15000));\r\n        $mensaje = \"Has recibido este correo porque has solicitado un cambio de email, \r\n            pincha en el siguiente enlace para confirmar tu cambio de email: http://localhost/clinica/controllers/verificar/cambiarEmail.php?email=\".$conexion->getEmail($idU).\"&token=\".$token;\r\n        if (enviarCorreoGmail($conexion->getEmail($idU), \"Cambio de email\", $mensaje)) {\r\n            $_SESSION['mensaje'] = '<script>alert(\"Correo enviado para verificar el cambio de email\")</script>';\r\n        } else {\r\n            $_SESSION['mensaje'] = '<script>alert(\"No se pudo enviar el correo de verificación, intentalo más tarde\")</script>';\r\n        }\r\n    }\r\n\r\n    if (isset($_POST[\"editarInfoUsuario\"])) {\r\n        if ($conexion->actualizarDatosUsuario($_POST[\"apellidos\"], $_POST[\"nombre\"], $idU,$_POST[\"direccion\"],$_POST[\"telefono\"],$_POST[\"cp\"])) {\r\n            $_SESSION[\"mensajeUsuario\"] = \"<p class='mensaje-exito'>Usuario actualizado correctamente</p>\";\r\n            $_SESSION[\"ruta\"] = \"usuario\";\r\n        } else {\r\n            $_SESSION[\"mensajeUsuario\"] = \"<p class='mensaje-error'>Error al actualizar usuario</p>\";\r\n        }\r\n        if($rol==3){\r\n            if ($conexionMedico->actualizarDatosMedico($_POST[\"apellidos\"], $_POST[\"nombre\"], $idU,$_POST[\"direccion\"],$_POST[\"telefono\"],$_POST[\"cp\"])) {\r\n                $_SESSION[\"mensaje\"] = \"<p class='mensaje-exito'>Usuario actualizado correctamente</p>\";\r\n                $_SESSION[\"ruta\"] = \"usuarioMedico\";\r\n            } else {\r\n                $_SESSION[\"mensaje\"] = \"<p class='mensaje-error'>Error al actualizar usuario</p>\";\r\n            }\r\n        }\r\n\r\n        header(\"Location: index.php\");\r\n        exit();\r\n    }\r\n    $consulta = $conexion->getInfoUsuario($idU);\r\n    if($conexion->getRol($email)==3){\r\n        require_once \"./views/vistaEditarMedico.php\";\r\n    }else{\r\n        require_once \"./views/vistaEditarUsuario.php\";\r\n    }\r\n\r\n}\r\n\r\n//Login\r\n\r\n\r\nif ($_SESSION[\"ruta\"] == \"login\") {\r\n    if ($_SERVER[\"REQUEST_METHOD\"] == \"POST\" && (isset($_POST['iniciarSesion']))) {\r\n        if (!$conexion->emailExiste($_POST[\"email\"])) {\r\n            $_SESSION[\"mensaje\"] = \"<p class='mensaje-error'>Credenciales incorrectas.</p>\";\r\n            header(\"Location: index.php\");\r\n            exit();\r\n        } else {\r\n            $usuario = $conexion->getUsuario($_POST[\"email\"]);\r\n\r\n            if (password_verify($_POST[\"password\"], $usuario->password)) {\r\n                if ($conexion->getRol($usuario->email) != 2 && $conexion->getRol($usuario->email) != 3 ) {\r\n                    $_SESSION[\"idU\"] = $conexion->getIDUsuario($usuario->email);\r\n                    $_SESSION[\"ruta\"] = 'usuario';\r\n                    $_SESSION[\"mensaje\"] = \"<p class='mensaje-exito'>Sesión iniciada correctamente.</p>\";\r\n                    header(\"Location: index.php\");\r\n                    exit;\r\n                }elseif($conexion->getRol($usuario->email)==3){\r\n                    $_SESSION[\"mensaje\"] = \"<p class='mensaje-error'>Credenciales incorrectas.</p>\";\r\n                    header(\"Location: index.php\");\r\n                    exit();\r\n                }\r\n\r\n                else {\r\n                    $_SESSION[\"mensaje\"] = \"<p class='mensaje-error'>Este usuario no está verificado.</p>\";\r\n                    header(\"Location: index.php\");\r\n                    exit();\r\n                }\r\n\r\n            } else {\r\n                $_SESSION[\"mensaje\"] = \"<p class='mensaje-error'>Credenciales incorrectas.</p>\";\r\n                header(\"Location: index.php\");\r\n                exit;\r\n            }\r\n\r\n\r\n        }\r\n\r\n\r\n    }\r\n\r\n    require_once \"./views/vistaLogin.php\";\r\n}\r\n\r\n\r\n\r\nif($_SESSION[\"ruta\"] == \"loginMedico\") {\r\n    if ($_SERVER[\"REQUEST_METHOD\"] == \"POST\" && (isset($_POST['iniciarSesion']))) {\r\n        if (!$conexion->emailExiste($_POST[\"email\"])) {\r\n            $_SESSION[\"mensaje\"] = \"<p class='mensaje-error'>Credenciales incorrectas.</p>\";\r\n            header(\"Location: index.php\");\r\n            exit();\r\n        } else {\r\n            $usuario = $conexion->getUsuario($_POST[\"email\"]);\r\n\r\n            if (password_verify($_POST[\"password\"], $usuario->password)) {\r\n                if ($conexion->getRol($usuario->email) == 3) {\r\n                    $_SESSION[\"idU\"] = $conexion->getIDUsuario($usuario->email);\r\n                    $_SESSION[\"ruta\"] = 'usuarioMedico';\r\n                    $_SESSION[\"mensaje\"] = \"<p class='mensaje-exito'>Sesión iniciada correctamente.</p>\";\r\n                    header(\"Location: index.php\");\r\n                    exit;\r\n                } else {\r\n                    $_SESSION[\"mensaje\"] = \"<p class='mensaje-error'>Este usuario no es médico.</p>\";\r\n                    header(\"Location: index.php\");\r\n                    exit();\r\n                }\r\n\r\n            } else {\r\n                $_SESSION[\"mensajeMedico\"] = \"<p class='mensaje-error'>Credenciales incorrectas.</p>\";\r\n                header(\"Location: index.php\");\r\n                exit;\r\n            }\r\n\r\n\r\n        }\r\n\r\n\r\n    }\r\n    require_once \"./views/vistaLoginMedico.php\";\r\n}\r\n\r\n\r\n//Registro\r\nif ($_SESSION[\"ruta\"] == \"registro\") {\r\n    if (isset($_POST[\"registrar\"])) {\r\n\r\n        if ($conexion->existeCorreo($_POST[\"correo\"]) || $conexion->existeDni($_POST[\"dni\"])) {\r\n            $_SESSION[\"mensaje\"] = \" <p class='mensaje-error'>El correo ya existe</p>\";\r\n            if($conexion->existeDni($_POST[\"dni\"])){\r\n                $_SESSION[\"mensaje\"] = \"<p class='mensaje-error'>El dni ya se encuentra registrado</p>\";\r\n            }\r\n        } else {\r\n            if (!Usuario::comprobarPassword($_POST[\"password\"], $_POST[\"cpassword\"])) {\r\n                $_SESSION[\"mensaje\"] = \"<p class='mensaje-error'>Las contraseñas no coinciden</p>\";\r\n            } else {\r\n                $_SESSION[\"dni\"] = $_POST[\"dni\"];\r\n                $_SESSION[\"nombre\"] = $_POST[\"nombre\"];\r\n                $_SESSION[\"apellidos\"] = $_POST[\"apellidos\"];\r\n                $_SESSION[\"direccion\"] = $_POST[\"direccion\"];\r\n                $_SESSION[\"telefono\"] = $_POST[\"telefono\"];\r\n                $_SESSION[\"cp\"] = $_POST[\"cp\"];\r\n                $_SESSION[\"email\"] = $_POST[\"email\"];\r\n                $_SESSION[\"password\"] = $_POST[\"password\"];\r\n                $_SESSION[\"cpassword\"] = $_POST[\"cpassword\"];\r\n                $_SESSION[\"insertarUsuario\"] = true;\r\n            }\r\n\r\n        }\r\n        header(\"Location: \" . $_SERVER['PHP_SELF']);\r\n        exit;\r\n\r\n    }\r\n\r\n    if (isset($_SESSION[\"insertarUsuario\"])) {\r\n        $hash = password_hash($_SESSION[\"password\"], PASSWORD_DEFAULT);\r\n        $usuario = new Usuario($_SESSION[\"dni\"], $_SESSION[\"apellidos\"], $_SESSION[\"nombre\"], $_SESSION[\"email\"], $hash, $_SESSION['direccion'],$_SESSION['telefono'],$_SESSION['cp'],2);\r\n        if ($conexion->insertarUsuario($usuario)) {\r\n\r\n\r\n            $token = hash('sha512', rand(1, 15000));\r\n            $mensaje = \"Has recibido este correo porque has solicitado registrarte en la aplicación, \r\n            pincha en el siguiente enlace para confirmar tu correo: http://aula2gs.edu/clinica/controllers/verificar/verificar.php?email=\" . $_SESSION['email'] . \"&token=\" . $token;\r\n            if (enviarCorreoGmail($_SESSION[\"email\"], \"Verificación de cuenta\", $mensaje)) {\r\n                $_SESSION['mensaje'] = '<script>alert(\"Correo enviado para verificar el usuario\")</script>';\r\n            } else {\r\n                $_SESSION['mensaje'] = '<script>alert(\"No se pudo enviar el correo de verificación, intentalo más tarde\")</script>';\r\n            }\r\n            unset($_SESSION[\"insertarUsuario\"], $_SESSION[\"dni\"], $_SESSION[\"apellidos\"], $_SESSION[\"nombre\"], $_SESSION[\"email\"], $_SESSION[\"password\"]);\r\n            header(\"Location: index.php\");\r\n            exit;\r\n        } else {\r\n            $_SESSION[\"mensaje\"] = \"<p class='mensaje-error'>Error al registrar usuario</p>\";\r\n            unset($_SESSION[\"insertarUsuario\"], $_SESSION[\"dni\"], $_SESSION[\"apellidos\"], $_SESSION[\"nombre\"], $_SESSION[\"email\"], $_SESSION[\"password\"]);\r\n            header(\"Location: \" . $_SERVER['PHP_SELF']);\r\n            exit;\r\n        }\r\n    }\r\n\r\n    require_once \"./views/vistaRegistro.php\";\r\n\r\n}\r\n//Citas\r\nif ($_SESSION[\"ruta\"] == \"citas\") {\r\n    if($idU==0){\r\n        $_SESSION[\"ruta\"] = \"login\";\r\n        header(\"Location: index.php\");\r\n        exit();\r\n    }\r\n    if (isset($_POST[\"cancelarCita\"]) && isset($_POST[\"idMedicoC\"]) && isset($_POST[\"idhoraC\"]) && isset($_POST[\"fechaC\"])) {\r\n        if ($conexionCita->borrarCita($_POST[\"fechaC\"], $_POST[\"idMedicoC\"], $_POST[\"idhoraC\"])) {\r\n            $_SESSION[\"mensajeCita\"] = \"<p class='mensaje-exito citas'>Cita cancelada correctamente.</p>\";\r\n            header(\"Location: \" . $_SERVER['PHP_SELF']);\r\n            exit;\r\n        } else {\r\n            $_SESSION[\"mensajeCita\"] = \"<p class='mensaje-error citas'>No se ha podido cancelar la cita.</p>\";\r\n            header(\"Location: \" . $_SERVER['PHP_SELF']);\r\n            exit;\r\n        }\r\n\r\n    }\r\n\r\n    $consulta = $conexionCita->getCitas($idU);\r\n    require_once \"./views/vistaCitas.php\";\r\n}\r\n\r\nif($_SESSION[\"ruta\"] == \"citasMedico\"){\r\n    if($idU==0){\r\n        $_SESSION[\"ruta\"] = \"login\";\r\n        header(\"Location: index.php\");\r\n        exit();\r\n    }\r\n    if(isset($_POST[\"buscar\"])){\r\n        $fecha = $_POST[\"fecha\"];\r\n    }\r\n    else{\r\n        $fecha=null;\r\n    }\r\n    $consulta = $conexionCita->getCitasMedico($idU,$fecha);\r\n    require_once \"./views/vistaCitasMedico.php\";\r\n}\r\n\r\nif($_SESSION[\"ruta\"] == \"informe\"){\r\n\r\n    if(isset($_POST[\"eliminar\"])){\r\n        $id=$_POST[\"id\"];\r\n        if($conexionInforme->eliminarInforme($id)){\r\n            $_SESSION['mensaje']=\"<p class='mensaje-exito'>Informe eliminado correctamente</p>\";\r\n        }\r\n        else{\r\n            $_SESSION['mensaje']=\"<p class='mensaje-error'>Error al eliminar informe</p>\";\r\n        }\r\n    }\r\n    if(isset($_POST[\"idPaciente\"])){\r\n        $_SESSION[\"idPaciente\"] = $_POST[\"idPaciente\"];\r\n    }\r\n\r\n    if(isset($_POST[\"editar\"])){\r\n        $_SESSION[\"ruta\"]=\"editarInforme\";\r\n        header(\"Location: \" . $_SERVER['PHP_SELF']);\r\n        exit;\r\n    }\r\n\r\n    $idUsuario = $_SESSION[\"idPaciente\"];\r\n    $nombrePaciente = $conexion->getNombreUsuario($idUsuario);\r\n    $apellidosPaciente = $conexion->getApellidosUsuario($idUsuario);\r\n    $dni = $conexion->getDni($idUsuario);\r\n    $consulta = $conexionInforme->getInformes($idUsuario);\r\n    require_once \"./views/vistaInforme.php\";\r\n}\r\n\r\nif($_SESSION[\"ruta\"] == \"editarInforme\"){\r\n    require_once \"./views/vistaEditarInforme.php\";\r\n\r\n}\r\n\r\n\r\nif($_SESSION[\"ruta\"] == \"crearInforme\"){\r\n    if(isset($_POST[\"crear\"])){\r\n        $idPaciente = $_SESSION[\"idPaciente\"];\r\n        $motivo = $_POST[\"motivo\