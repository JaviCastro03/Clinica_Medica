55, 255, 0.1);\r\n    transform: translateY(-2px);\r\n}\r\n\r\n@media (max-width: 992px) {\r\n    .content h1 {\r\n        font-size: 2.8em;\r\n    }\r\n    .content .subtitle {\r\n        font-size: 1.2em;\r\n    }\r\n    .cta-buttons {\r\n        flex-direction: column; \r\n    }\r\n    .btn {\r\n        padding: 12px 25px;\r\n        width: 100%; \r\n    }\r\n}\r\n\r\n@media (max-width: 576px) {\r\n    .content h1 {\r\n        font-size: 2em;\r\n    }\r\n}\r\n\r\n/* ----------------------------------- */\r\n/* 6. BOTONES */\r\n/* ----------------------------------- */\r\n.btn {\r\n    display: inline-block;\r\n    padding: 10px 20px;\r\n    border-radius: 4px;\r\n    font-weight: bold;\r\n    text-align: center;\r\n    transition: background-color 0.3s ease;\r\n}\r\n\r\n.btn--secondary {\r\n    background-color: var(--color-green);\r\n    color: var(--color-white);\r\n    border: 2px solid var(--color-green);\r\n}\r\n\r\n.btn--secondary:hover {\r\n    background-color: #4CAF50;\r\n    border-color: #4CAF50;\r\n}\r\n\r\n/* ----------------------------------- */\r\n/* 7. SERVICIOS */\r\n/* ----------------------------------- */\r\n.services {\r\n    padding: 70px 6%;\r\n    max-width: 1300px;\r\n    margin: 0 auto;\r\n    text-align: center;\r\n}\r\n\r\n.usuarios-admin {\r\n    padding: 70px 6%;\r\n    max-width: 1800px;\r\n    margin: 0 auto;\r\n    text-align: center;\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 1rem;\r\n\r\n}\r\n\r\n\r\n .button-especialidad{\r\n    display: flex;\r\n    flex-direction: column;\r\n    flex: 1;\r\n    width: 100%;\r\n     height: 100%;\r\n    padding: 0;\r\n    background: none;\r\n}\r\n.services__title {\r\n    font-size: 2.4rem;\r\n    margin-bottom: 50px;\r\n    font-weight: 600;\r\n}\r\n\r\n\r\n.services__card-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); \r\n    gap: 30px;\r\n}\r\n\r\n\r\n.card-title {\r\n    color: var(--color-blue-hard); \r\n    font-size: 1.6rem; \r\n    line-height: 1.2;\r\n    font-weight: 700;\r\n    margin-bottom: 0.4em;\r\n    transition: color 0.4s ease;\r\n}\r\n\r\n.small-desc {\r\n    font-size: 1em;\r\n    font-weight: 400;\r\n    line-height: 1.6em;\r\n    color: var(--color-text-grey);\r\n    \r\n}\r\n\r\n\r\n.card {\r\n    display: flex;\r\n    flex-direction: column;\r\n    justify-content: space-between;\r\n    text-align: left;\r\n    height: 100%; \r\n    max-width: none;\r\n    max-height: none;\r\n    margin: 0; \r\n    background-color: var(--color-white);\r\n    border-radius: 12px;\r\n    padding: 2em 1.5em; \r\n    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);\r\n    transition: all 0.4s ease;\r\n    border: 2px solid var(--color-border);\r\n    position: relative;\r\n    overflow: hidden;\r\n    z-index: 1;\r\n    width: 100%;\r\n}\r\n\r\n.go-corner {\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    position: absolute;\r\n    width: 2.5em;\r\n    height: 2.5em;\r\n    overflow: hidden;\r\n    top: -2px; \r\n    right: -2px;\r\n    background: var(--color-blue-soft);\r\n    border-radius: 0 10px 0 10px; \r\n    z-index: 2;\r\n}\r\n\r\n.go-star {\r\n    margin-top: 0;\r\n    margin-right: 0;\r\n    color: var(--color-white);\r\n    font-size: 1.2em;\r\n}\r\n\r\n\r\n.card:before {\r\n    content: none; \r\n}\r\n\r\n.card:hover {\r\n    box-shadow: 0 10px 30px rgba(42, 136, 179, 0.2); \r\n    transform: translateY(-5px); \r\n    border-color: var(--color-blue-soft); \r\n}\r\n\r\n.card:hover .small-desc {\r\n    transition: none;\r\n    color: var(--color-text-grey);\r\n}\r\n\r\n.card:hover .card-title {\r\n    transition: color 0.4s ease;\r\n    color: var(--color-blue-soft); \r\n}\r\n\r\n\r\n.btn--large {\r\n    padding: 18px 40px;\r\n    font-size: 1.2em;\r\n    border-radius: 10px;\r\n}\r\n\r\n/* ----------------------------------- */\r\n/* 8. GALERIA */\r\n/* ----------------------------------- */\r\n\r\n\r\n.seccion {\r\n    padding: 70px 6%;\r\n    max-width: 90%;\r\n    margin: 0 auto;\r\n    text-align: center;\r\n    \r\n}\r\n\r\n.seccion-titulo {\r\n    font-size: 2.4rem;\r\n    margin-bottom: 50px;\r\n    font-weight: 600;\r\n    color: var(--color-blue-hard);\r\n}\r\n\r\n.gal {\r\n    display: flex;\r\n    width: 100%;\r\n    height: 400px; \r\n    overflow: hidden; \r\n    border-radius: 12px; \r\n    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15); \r\n  }\r\n\r\n  .gal img{\r\n    width: 0px;\r\n    flex-grow: 1;\r\n    object-fit: cover;\r\n    opacity: .8;\r\n    transition: .5s ease;\r\n  }\r\n  .gal img:hover{\r\n    width: 300px;\r\n    opacity: 1;\r\n    filter: contrast(110%);\r\n\r\n  }\r\n  @media (max-width: 1024px) {\r\n    .gal {\r\n      height: 300px;\r\n    }\r\n    .gal img:hover {\r\n      width: 220px;\r\n    }\r\n  }\r\n\r\n  @media (max-width: 768px) {\r\n    .gal {\r\n      flex-direction: column;\r\n      height: auto;\r\n      gap: 4px;\r\n     \r\n    }\r\n    .gal img {\r\n      width: 100% ;\r\n      height: 200px;\r\n      flex-grow: unset;\r\n      opacity: 1;\r\n    }\r\n    .gal img:hover {\r\n      width: 100% ;\r\n    }\r\n  }\r\n\r\n  @media (max-width: 480px) {\r\n    .gal img {\r\n      height: 150px;\r\n    }\r\n  }\r\n\r\n/* ----------------------------------- */\r\n/* 9. FILOSOFÍA Y COMPROMISO */\r\n/* ----------------------------------- */\r\n.philosophy {\r\n    padding: 70px 6%;\r\n    background-color: var(--color-border); \r\n    text-align: center;\r\n}\r\n\r\n.philosophy__container {\r\n    max-width: 1100px;\r\n    margin: 0 auto;\r\n}\r\n\r\n.philosophy__title {\r\n    font-size: 2.4rem;\r\n    margin-bottom: 50px;\r\n    font-weight: 700;\r\n    color: var(--color-blue-hard);\r\n}\r\n\r\n.philosophy__content {\r\n    display: flex;\r\n    gap: 30px;\r\n    margin-bottom: 50px;\r\n    text-align: left;\r\n}\r\n\r\n.philosophy__card {\r\n    flex: 1;\r\n    background-color: var(--color-white);\r\n    padding: 30px;\r\n    border-radius: 12px;\r\n    box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);\r\n    transition: transform 0.3s ease;\r\n}\r\n\r\n.philosophy__card h3 {\r\n    color: var(--color-blue-soft);\r\n    font-size: 1.6rem;\r\n    margin-top: 0;\r\n    margin-bottom: 15px;\r\n    border-bottom: 2px solid var(--color-border);\r\n    padding-bottom: 10px;\r\n}\r\n\r\n.philosophy__card p {\r\n    font-size: 1.1em;\r\n    color: var(--color-text-grey);\r\n}\r\n\r\n.philosophy__card:hover {\r\n    transform: translateY(-5px); \r\n}\r\n\r\n.policy-links {\r\n    padding-top: 20px;\r\n    border-top: 1px solid var(--color-text-grey);\r\n}\r\n\r\n.policy-links h4 {\r\n    font-size: 1.3rem;\r\n    color: var(--color-blue-dark);\r\n    margin-bottom: 20px;\r\n}\r\n\r\n.btn-policy {\r\n    display: inline-block;\r\n    padding: 10px 20px;\r\n    margin: 5px 10px;\r\n    background-color: var(--color-blue-hard);\r\n    color: var(--color-white);\r\n    border-radius: 6px;\r\n    font-weight: 600;\r\n    transition: background-color 0.3s;\r\n}\r\n\r\n.btn-policy:hover {\r\n    background-color: var(--color-blue-soft);\r\n}\r\n\r\n@media (max-width: 768px) {\r\n    .philosophy__content {\r\n        flex-direction: column; \r\n    }\r\n    .philosophy__card {\r\n        margin-bottom: 20px;\r\n    }\r\n}\r\n\r\n\r\n/* ----------------------------------- */\r\n/* 10. SECCION FINAL */\r\n/* ----------------------------------- */\r\n.cta-section {\r\n    background-color: var(--color-blue-hard);\r\n    color: var(--color-white);\r\n    text-align: center;\r\n    padding: 80px 5%; \r\n}\r\n\r\n.cta-icon {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    margin-bottom: 20px; \r\n}\r\n\r\n.cta-icon span {\r\n    display: block; \r\n    line-height: 1; \r\n    animation: glow 2.5s infinite ease-in-out; \r\n    border-radius: 50%; \r\n    padding: 10px; \r\n}\r\n\r\n.cta-icon span img {\r\n    height: 90px; \r\n    width: auto;\r\n    display: block; \r\n    object-fit: contain; \r\n}\r\n\r\n@keyframes glow {\r\n    0% { \r\n        box-shadow: 0 0 8px rgba(255, 255, 255, 0.4), 0 0 15px var(--color-green); \r\n        transform: scale(1);\r\n    }\r\n    50% { \r\n        box-shadow: 0 0 15px rgba(255, 255, 255, 0.7), 0 0 30px var(--color-green); \r\n        transform: scale(1.03); /* Ligeramente más grande */\r\n    }\r\n    100% { \r\n        box-shadow: 0 0 8px rgba(255, 255, 255, 0.4), 0 0 15px var(--color-green); \r\n        transform: scale(1);\r\n    }\r\n}\r\n\r\n.cta-section__title {\r\n    color: var(--color-white);\r\n    font-size: 2.8rem; \r\n    margin-bottom: 15px;\r\n    font-weight: 700;\r\n}\r\n\r\n.cta-section__subtitle {\r\n    font-size: 1.2rem;\r\n    color: var(--color-transition1); \r\n    margin-bottom: 40px;\r\n    max-width: 700px;\r\n    margin-left: auto;\r\n    margin-right: auto;\r\n}\r\n\r\n.stepper-wrapper {\r\n    margin-top: auto;\r\n    display: flex;\r\n    justify-content: space-between;\r\n    margin-bottom: 20px;\r\n}\r\n.stepper-item {\r\n    position: relative;\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n    flex: 1;\r\n\r\n    @media (max-width: 768px) {\r\n        font-size: 12px;\r\n    }\r\n}\r\n\r\n.stepper-item::before {\r\n    position: absolute;\r\n    content: \"\";\r\n    border-bottom: 2px solid #ccc;\r\n    width: 100%;\r\n    top: 20px;\r\n    left: -50%;\r\n    z-index: 2;\r\n}\r\n\r\n.stepper-item::after {\r\n    position: absolute;\r\n    content: \"\";\r\n    border-bottom: 2px solid #ccc;\r\n    width: 100%;\r\n    top: 20px;\r\n    left: 50%;\r\n    z-index: 2;\r\n}\r\n\r\n.stepper-item .step-counter {\r\n    position: relative;\r\n    z-index: 5;\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    width: 40px;\r\n    height: 40px;\r\n    border-radius: 50%;\r\n    background: #ccc;\r\n    margin-bottom: 6px;\r\n}\r\n\r\n.stepper-item.active {\r\n    font-weight: bold;\r\n}\r\n\r\n.stepper-item.completed .ste