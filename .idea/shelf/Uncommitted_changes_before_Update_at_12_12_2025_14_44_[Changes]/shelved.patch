nter;\r\n        justify-content: center;\r\n        border-radius: 6px;\r\n        letter-spacing: 1px;\r\n        transition: all 0.25s linear;\r\n        cursor: pointer;\r\n        border: none;\r\n        color: var(--color-white);\r\n        font-size: 6px;\r\n        padding: 6px;\r\n    }\r\n    .input-date{\r\n        font-size: 12px;\r\n        padding: 0.6rem;\r\n    }\r\n}\r\n\r\n/* ----------------------------------- */\r\n/* 11. FOOTER */\r\n/* ----------------------------------- */\r\n.footer {\r\n    text-align: center;\r\n    padding: 25px 5%;\r\n    background-color: var(--color-white);\r\n    color: var(--color-text-grey);\r\n    font-size: 0.9em;\r\n    border-top: 1px solid var(--color-border);\r\n}\r\n\r\n.footer__text {\r\n    font-size: 0.9em;\r\n}\r\n\r\n/* ----------------------------------- */\r\n/* 12. TABLA USUARIOSADMIN */\r\n/* ----------------------------------- */\r\n.pagina-usuarios-admin * {\r\n    font-family: \"Poppins\", sans-serif;\r\n}\r\n\r\n.pagina-usuarios-admin .header__logo img {\r\n    width: 180px;\r\n    margin-top: 5px;\r\n}\r\n\r\n.pagina-usuarios-admin .nav {\r\n    display: flex;\r\n    font-weight: 500;\r\n    font-size: 18px;\r\n    gap: 30px;\r\n    z-index: 1000;\r\n}\r\n\r\n.pagina-usuarios-admin .nav__item {\r\n    background-color: var(--color-white);\r\n    color: var(--color-blue-hard);\r\n    border: 2px solid var(--color-blue-hard);\r\n    border-radius: 10px;\r\n    padding: 8px 20px;\r\n    cursor: pointer;\r\n}\r\n\r\n.pagina-usuarios-admin .nav__item--active {\r\n    background-color: var(--color-blue-hard);\r\n    color: var(--color-white);\r\n}\r\n\r\n.tabla-responsive-container {\r\n    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);\r\n    border-radius: 10px;\r\n    overflow: hidden;\r\n    margin-top: 20px;\r\n}\r\n\r\n.pagina-usuarios-admin .tabla {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    margin-top: 0;\r\n    margin-bottom: 0;\r\n}\r\n\r\n.pagina-usuarios-admin .tabla th {\r\n 