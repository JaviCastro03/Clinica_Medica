<+>/* ----------------------------------- */\r\n/* 1. VARIABLES DE COLOR */\r\n/* ----------------------------------- */\r\n:root {\r\n    --color-blue-dark:#363960;\r\n    --color-blue-hard: #033D69;\r\n    --color-danger: #f15656;\r\n    --color-blue-soft: #2A88B3;\r\n    --color-green: #5CB85C;\r\n    --color-white: #FFFFFF;\r\n    --color-text-grey: #495057;\r\n    --color-border: #E9ECEF;\r\n    --color-transition1:#c3d6dc;\r\n    --color-transition2:#a7d1d9;\r\n    --color-fondo-overlay: rgba(0, 0, 0, 0.4); \r\n}\r\n\r\n/* ----------------------------------- */\r\n/* 2. BASE */\r\n/* ----------------------------------- */\r\n* {\r\n    box-sizing: border-box;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n\r\n\r\nbutton{\r\n    border: none;\r\n    background-color: white;\r\n    font-size: 1.1rem;\r\n}\r\nbody {\r\n    font-family: 'Poppins', sans-serif;\r\n    line-height: 1.6;\r\n    color: var(--color-text-grey);\r\n    background-color: var(--color-white);\r\n}\r\n\r\na {\r\n    text-decoration: none;\r\n    color: var(--color-blue-soft);\r\n}\r\n\r\nh1, h2, h3 {\r\n    color: var(--color-blue-hard);\r\n    margin-bottom: 0.5em;\r\n    line-height: 1.2;\r\n}\r\n\r\nstrong {\r\n    color: var(--color-blue-soft);\r\n}\r\n\r\n/* ----------------------------------- */\r\n/* 3. HEADER */\r\n/* ----------------------------------- */\r\n.header {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    padding: 15px 5%; \r\n    background-color: var(--color-white);\r\n    border-bottom: 1px solid var(--color-border);\r\n    position: sticky; \r\n    top: 0;          \r\n    z-index: 1000;  \r\n}\r\n\r\n.header__logo img {\r\n    height: 65px; \r\n    width: auto;\r\n    transition: height 0.3s;\r\n}\r\n\r\n/* ----------------------------------- */\r\n/* 4. NAV */\r\n/* ----------------------------------- */\r\n.nav {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 25px;\r\n}\r\n\r\n.nav__item {\r\n    font-weight: 500;\r\n    white-space: nowrap;\r\n    color: var(--color-text-grey); \r\n    transition: color 0.3s, border-bottom 0.3s;\r\n    border: none;\r\n    background-color: white;\r\n}\r\n\r\n.nav__item:hover {\r\n    color: var(--color-blue-soft); \r\n}\r\n\r\n.nav__item--active {\r\n    color: var(--color-blue-hard);\r\n    font-weight: 500;\r\n    border: none;\r\n    border-bottom: 2px solid var(--color-blue-soft);\r\n    background-color: white;\r\n}\r\n\r\n.nav__auth-group {\r\n    display: flex;\r\n    border-left: 1px solid var(--color-border);\r\n    padding-left: 20px;\r\n}\r\n\r\n.nav__auth-link {\r\n    font-size: 1em; \r\n    color: var(--color-blue-dark); \r\n    margin-left: 12px;\r\n    font-weight: 500;\r\n    border: none;\r\n    background-color: white;\r\n\r\n}\r\n\r\n.nav__auth-link:hover {\r\n    color: var(--color-blue-soft);\r\n}\r\n/* ----------------------------------- */\r\n/* HAMBURGUESA */\r\n/* ----------------------------------- */\r\n.nav__toggle, \r\n.nav__hamburger {\r\n    display: none;\r\n}\r\n\r\n@media (max-width: 1000px) {\r\n    .nav__hamburger {\r\n        display: flex;\r\n        flex-direction: column;\r\n        justify-content: space-around;\r\n        width: 30px;\r\n        height: 24px;\r\n        cursor: pointer;\r\n        z-index: 1001; \r\n        margin-left: 20px;\r\n    }\r\n\r\n    .nav__hamburger span {\r\n        display: block;\r\n        height: 3px;\r\n        width: 100%;\r\n        background: var(--color-text-grey);\r\n        border-radius: 3px;\r\n        transition: all 0.3s ease-in-out;\r\n    }\r\n\r\n    .nav {\r\n        display: none; \r\n        flex-direction: column;\r\n        position: absolute;\r\n        top: 100%; \r\n        left: 0;\r\n        width: 100%;\r\n        background-color: var(--color-white);\r\n        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);\r\n        padding: 10px 0;\r\n        z-index: 1000;\r\n        border-top: 1px solid var(--color-border);\r\n    }\r\n    \r\n    .nav__item {\r\n        width: 100%;\r\n        text-align: center;\r\n        padding: 12px 0;\r\n        border-bottom: 1px solid var(--color-border);\r\n    }\r\n\r\n    .nav__item--active {\r\n        border-bottom: none;\r\n    }\r\n\r\n    .nav__item:hover {\r\n        background-color: var(--color-border);\r\n        color: var(--color-blue-soft);\r\n    }\r\n\r\n    .nav__auth-group {\r\n        flex-direction: column;\r\n        border-left: none; \r\n        border-top: 1px solid var(--color-border);\r\n        padding: 10px 0;\r\n        margin-left: 0;\r\n        text-align: center;\r\n        width: 100%;\r\n    }\r\n    \r\n    .nav__auth-link {\r\n        padding: 8px 0;\r\n        margin: 5px auto;\r\n    }\r\n\r\n    .button {\r\n        width: 80%;\r\n        margin: 15px auto;\r\n        padding: 0;\r\n        height: 3.5em;\r\n    }\r\n\r\n\r\n    .nav__toggle:checked ~ .nav {\r\n        display: flex;\r\n    }\r\n    \r\n    .nav__toggle:checked ~ .nav__hamburger span:nth-child(1) {\r\n        transform: rotate(45deg) translate(6px, 6px);\r\n    }\r\n\r\n    .nav__toggle:checked ~ .nav__hamburger span:nth-child(2) {\r\n        opacity: 0;\r\n    }\r\n\r\n    .nav__toggle:checked ~ .nav__hamburger span:nth-child(3) {\r\n        transform: rotate(-45deg) translate(6px, -6px);\r\n    }\r\n\r\n\r\n}\r\n\r\n\r\n@media (min-width: 1001px) {\r\n    .nav {\r\n        gap: 15px; \r\n    }\r\n\r\n\r\n\r\n    .button {\r\n        display: flex;\r\n        margin-left: 20px;\r\n    }\r\n}\r\n\r\n\r\n.button {\r\n  display: flex;\r\n  height: 3em;\r\n  width: 160px;\r\n  align-items: center;\r\n  justify-content: center;\r\n  border-radius: 6px;\r\n  letter-spacing: 1px;\r\n  transition: all 0.25s linear;\r\n  cursor: pointer;\r\n  border: none;\r\n  background: var(--color-green);\r\n  color: var(--color-white);\r\n\r\n  font-family: 'Poppins', sans-serif;\r\n  font-weight: 600;\r\n  font-size: 0.9rem;\r\n  white-space: nowrap;\r\n}\r\n\r\n.button .wrap p {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 8px;\r\n  margin: 0;\r\n  position: relative;   \r\n}\r\n\r\n.button span {\r\n  position: absolute;\r\n  left: 0;\r\n  transition: opacity 0.2s ease;\r\n}\r\n\r\n.button .wrap p::before {\r\n  content: \"\";\r\n  display: inline-block;\r\n  width: 18px;\r\n  height: 1px;\r\n}\r\n\r\n.button:hover {\r\n  box-shadow: 0px 0px 5px var(--color-text-grey),\r\n              -9px -9px 33px #ffffff;\r\n}\r\n.table-flex{\r\n    display: flex;\r\n\r\n}\r\n.button span:nth-child(1) {\r\n  opacity: 1;\r\n}\r\n\r\n.button span:nth-child(2) {\r\n  opacity: 0;\r\n}\r\n\r\n.button:hover span:nth-child(1) {\r\n  opacity: 0;\r\n}\r\n\r\n.button:hover span:nth-child(2) {\r\n  opacity: 1;\r\n}\r\n\r\n\r\n.button-table {\r\n    display: flex;\r\n    height: 1.8rem;\r\n    min-width: 6rem;\r\n    text-align: center;\r\n    align-items: center;\r\n    justify-content: center;\r\n    border-radius: 6px;\r\n    letter-spacing: 1px;\r\n    transition: all 0.25s linear;\r\n    cursor: pointer;\r\n    border: none;\r\n    background: var(--color-green);\r\n    color: var(--color-white);\r\n    font-size: 0.9rem;\r\n}\r\n.button-table:hover {\r\n    box-shadow: 0px 0px 5px var(--color-text-grey),\r\n    -9px -9px 33px #ffffff;\r\n}\r\n\r\n\r\n/* ----------------------------------- */\r\n/* 5. VIDEO */\r\n/* ----------------------------------- */\r\n\r\n.video-background {\r\n    position: relative;\r\n    width: 100%;\r\n    height: 100vh;\r\n    overflow: hidden;\r\n}\r\n\r\n/* Video */\r\n#background-video {\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    width: 100%;\r\n    height: 100%;\r\n    object-fit: cover;\r\n    z-index: 1;\r\n}\r\n\r\n.video-overlay {\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    width: 100%;\r\n    height: 100%;\r\n    background: linear-gradient(\r\n        180deg,\r\n        rgba(0, 0, 0, 0.45) 0%,\r\n        rgba(0, 0, 0, 0.75) 100%\r\n    );\r\n    z-index: 2;\r\n}\r\n\r\n.content {\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    width: 100%;\r\n    height: 100%;\r\n    display: flex;\r\n    flex-direction: column;\r\n    justify-content: center;\r\n    align-items: center;\r\n    text-align: center;\r\n    z-index: 3;\r\n    padding: 0 20px; \r\n}\r\n\r\n.content h1 {\r\n    font-size: 3.8em; \r\n    color: var(--color-white); \r\n    text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.9);\r\n    margin-bottom: 0.2em; \r\n    line-height: 1.1;\r\n}\r\n\r\n.content .subtitle {\r\n    font-size: 1.5em;\r\n    color: var(--color-transition1); \r\n    text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.7);\r\n    margin-bottom: 2em; \r\n    max-width: 800px; \r\n}\r\n\r\n.cta-buttons {\r\n    display: flex;\r\n    gap: 20px;\r\n    flex-wrap: wrap;\r\n    justify-content: center;\r\n}\r\n@keyframes slideInFromBottom {\r\n    0% {\r\n        opacity: 0;\r\n        transform: translateY(20px); \r\n    }\r\n    100% {\r\n        opacity: 1;\r\n        transform: translateY(0); \r\n    }\r\n}\r\n\r\n.cta-buttons .btn {\r\n    opacity: 0; \r\n    animation: slideInFromBottom 0.6s ease-out forwards;\r\n}\r\n\r\n.cta-buttons .btn:nth-child(1) {\r\n    animation-delay: 0.2s;\r\n}\r\n\r\n.cta-buttons .btn:nth-child(2) {\r\n    animation-delay: 0.4s; \r\n}\r\n\r\n.btn {\r\n    padding: 15px 35px;\r\n    font-size: 1.1em;\r\n    font-weight: bold;\r\n    text-decoration: none;\r\n    border-radius: 8px;\r\n    transition: background-color 0.3s, transform 0.2s;\r\n}\r\n\r\n.btn-primary-hero {\r\n    background-color: var(--color-blue-soft); \r\n    color: var(--color-white);\r\n}\r\n\r\n.btn-primary-hero:hover {\r\n    background-color: var(--color-blue-hard);\r\n    transform: translateY(-2px);\r\n}\r\n\r\n.btn-secondary-hero {\r\n    background-color: transparent;\r\n    color: var(--color-white);\r\n    border: 2px solid var(--color-white);\r\n}\r\n\r\n.btn-secondary-hero:hover {\r\n    background-color: rgba(255, 255, 255, 0.1);\r\n    transform: translateY(-2px);\r\n}\r\n\r\n@media (max-width: 992px) {\r\n    .content h1 {\r\n        font-size: 2.8em;\r\n    }\r\n    .content .subtitle {\r\n        font-size: 1.2em;\r\n    }\r\n    .cta-buttons {\r\n        flex-direction: column; \r\n    }\r\n    .btn {\r\n        padding: 12px 25px;\r\n        width: 100%; \r\n    }\r\n}\r\n\r\n@media (max-width: 576px) {\r\n    .content h1 {\r\n        font-size: 2em;\r\n    }\r\n}\r\n\r\n/* ----------------------------------- */\r\n/* 6. BOTONES */\r\n/* ----------------------------------- */\r\n.btn {\r\n    display: inline-block;\r\n    padding: 10px 20px;\r\n    border-radius: 4px;\r\n    font-weight: bold;\r\n    text-align: center;\r\n    transition: background-color 0.3s ease;\r\n}\r\n\r\n.btn--secondary {\r\n    background-color: var(--color-green);\r\n    color: var(--color-white);\r\n    border: 2px solid var(--color-green);\r\n}\r\n\r\n.btn--secondary:hover {\r\n    background-color: #4CAF50;\r\n    border-color: #4CAF50;\r\n}\r\n\r\n/* ----------------------------------- */\r\n/* 7. SERVICIOS */\r\n/* ----------------------------------- */\r\n.services {\r\n    padding: 70px 6%;\r\n    max-width: 1300px;\r\n    margin: 0 auto;\r\n    text-align: center;\r\n}\r\n .button-especialidad{\r\n    display: flex;\r\n    flex-direction: column;\r\n    flex: 1;\r\n    width: 100%;\r\n     height: 100%;\r\n    padding: 0;\r\n    background: none;\r\n}\r\n.services__title {\r\n    font-size: 2.4rem;\r\n    margin-bottom: 50px;\r\n    font-weight: 600;\r\n}\r\n\r\n\r\n.services__card-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); \r\n    gap: 30px;\r\n}\r\n\r\n\r\n.card-title {\r\n    color: var(--color-blue-hard); \r\n    font-size: 1.6rem; \r\n    line-height: 1.2;\r\n    font-weight: 700;\r\n    margin-bottom: 0.4em;\r\n    transition: color 0.4s ease;\r\n}\r\n\r\n.small-desc {\r\n    font-size: 1em;\r\n    font-weight: 400;\r\n    line-height: 1.6em;\r\n    color: var(--color-text-grey);\r\n    \r\n}\r\n\r\n\r\n.card {\r\n    display: flex;\r\n    flex-direction: column;\r\n    justify-content: space-between;\r\n    text-align: left;\r\n    height: 100%; \r\n    max-width: none;\r\n    max-height: none;\r\n    margin: 0; \r\n    background-color: var(--color-white);\r\n    border-radius: 12px;\r\n    padding: 2em 1.5em; \r\n    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);\r\n    transition: all 0.4s ease;\r\n    border: 2px solid var(--color-border);\r\n    position: relative;\r\n    overflow: hidden;\r\n    z-index: 1;\r\n    width: 100%;\r\n}\r\n\r\n.go-corner {\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    position: absolute;\r\n    width: 2.5em;\r\n    height: 2.5em;\r\n    overflow: hidden;\r\n    top: -2px; \r\n    right: -2px;\r\n    background: var(--color-blue-soft);\r\n    border-radius: 0 10px 0 10px; \r\n    z-index: 2;\r\n}\r\n\r\n.go-star {\r\n    margin-top: 0;\r\n    margin-right: 0;\r\n    color: var(--color-white);\r\n    font-size: 1.2em;\r\n}\r\n\r\n\r\n.card:before {\r\n    content: none; \r\n}\r\n\r\n.card:hover {\r\n    box-shadow: 0 10px 30px rgba(42, 136, 179, 0.2); \r\n    transform: translateY(-5px); \r\n    border-color: var(--color-blue-soft); \r\n}\r\n\r\n.card:hover .small-desc {\r\n    transition: none;\r\n    color: var(--color-text-grey);\r\n}\r\n\r\n.card:hover .card-title {\r\n    transition: color 0.4s ease;\r\n    color: var(--color-blue-soft); \r\n}\r\n\r\n\r\n.btn--large {\r\n    padding: 18px 40px;\r\n    font-size: 1.2em;\r\n    border-radius: 10px;\r\n}\r\n\r\n/* ----------------------------------- */\r\n/* 8. GALERIA */\r\n/* ----------------------------------- */\r\n\r\n\r\n.seccion {\r\n    padding: 70px 6%;\r\n    max-width: 90%;\r\n    margin: 0 auto;\r\n    text-align: center;\r\n    \r\n}\r\n\r\n.seccion-titulo {\r\n    font-size: 2.4rem;\r\n    margin-bottom: 50px;\r\n    font-weight: 600;\r\n    color: var(--color-blue-hard);\r\n}\r\n\r\n.gal {\r\n    display: flex;\r\n    width: 100%;\r\n    height: 400px; \r\n    overflow: hidden; \r\n    border-radius: 12px; \r\n    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15); \r\n  }\r\n\r\n  .gal img{\r\n    width: 0px;\r\n    flex-grow: 1;\r\n    object-fit: cover;\r\n    opacity: .8;\r\n    transition: .5s ease;\r\n  }\r\n  .gal img:hover{\r\n    width: 300px;\r\n    opacity: 1;\r\n    filter: contrast(110%);\r\n\r\n  }\r\n  @media (max-width: 1024px) {\r\n    .gal {\r\n      height: 300px;\r\n    }\r\n    .gal img:hover {\r\n      width: 220px;\r\n    }\r\n  }\r\n\r\n  @media (max-width: 768px) {\r\n    .gal {\r\n      flex-direction: column;\r\n      height: auto;\r\n      gap: 4px;\r\n     \r\n    }\r\n    .gal img {\r\n      width: 100% ;\r\n      height: 200px;\r\n      flex-grow: unset;\r\n      opacity: 1;\r\n    }\r\n    .gal img:hover {\r\n      width: 100% ;\r\n    }\r\n  }\r\n\r\n  @media (max-width: 480px) {\r\n    .gal img {\r\n      height: 150px;\r\n    }\r\n  }\r\n\r\n/* ----------------------------------- */\r\n/* 9. FILOSOFÍA Y COMPROMISO */\r\n/* ----------------------------------- */\r\n.philosophy {\r\n    padding: 70px 6%;\r\n    background-color: var(--color-border); \r\n    text-align: center;\r\n}\r\n\r\n.philosophy__container {\r\n    max-width: 1100px;\r\n    margin: 0 auto;\r\n}\r\n\r\n.philosophy__title {\r\n    font-size: 2.4rem;\r\n    margin-bottom: 50px;\r\n    font-weight: 700;\r\n    color: var(--color-blue-hard);\r\n}\r\n\r\n.philosophy__content {\r\n    display: flex;\r\n    gap: 30px;\r\n    margin-bottom: 50px;\r\n    text-align: left;\r\n}\r\n\r\n.philosophy__card {\r\n    flex: 1;\r\n    background-color: var(--color-white);\r\n    padding: 30px;\r\n    border-radius: 12px;\r\n    box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);\r\n    transition: transform 0.3s ease;\r\n}\r\n\r\n.philosophy__card h3 {\r\n    color: var(--color-blue-soft);\r\n    font-size: 1.6rem;\r\n    margin-top: 0;\r\n    margin-bottom: 15px;\r\n    border-bottom: 2px solid var(--color-border);\r\n    padding-bottom: 10px;\r\n}\r\n\r\n.philosophy__card p {\r\n    font-size: 1.1em;\r\n    color: var(--color-text-grey);\r\n}\r\n\r\n.philosophy__card:hover {\r\n    transform: translateY(-5px); \r\n}\r\n\r\n.policy-links {\r\n    padding-top: 20px;\r\n    border-top: 1px solid var(--color-text-grey);\r\n}\r\n\r\n.policy-links h4 {\r\n    font-size: 1.3rem;\r\n    color: var(--color-blue-dark);\r\n    margin-bottom: 20px;\r\n}\r\n\r\n.btn-policy {\r\n    display: inline-block;\r\n    padding: 10px 20px;\r\n    margin: 5px 10px;\r\n    background-color: var(--color-blue-hard);\r\n    color: var(--color-white);\r\n    border-radius: 6px;\r\n    font-weight: 600;\r\n    transition: background-color 0.3s;\r\n}\r\n\r\n.btn-policy:hover {\r\n    background-color: var(--color-blue-soft);\r\n}\r\n\r\n@media (max-width: 768px) {\r\n    .philosophy__content {\r\n        flex-direction: column; \r\n    }\r\n    .philosophy__card {\r\n        margin-bottom: 20px;\r\n    }\r\n}\r\n\r\n\r\n/* ----------------------------------- */\r\n/* 10. SECCION FINAL */\r\n/* ----------------------------------- */\r\n.cta-section {\r\n    background-color: var(--color-blue-hard);\r\n    color: var(--color-white);\r\n    text-align: center;\r\n    padding: 80px 5%; \r\n}\r\n\r\n.cta-icon {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    margin-bottom: 20px; \r\n}\r\n\r\n.cta-icon span {\r\n    display: block; \r\n    line-height: 1; \r\n    animation: glow 2.5s infinite ease-in-out; \r\n    border-radius: 50%; \r\n    padding: 10px; \r\n}\r\n\r\n.cta-icon span img {\r\n    height: 90px; \r\n    width: auto;\r\n    display: block; \r\n    object-fit: contain; \r\n}\r\n\r\n@keyframes glow {\r\n    0% { \r\n        box-shadow: 0 0 8px rgba(255, 255, 255, 0.4), 0 0 15px var(--color-green); \r\n        transform: scale(1);\r\n    }\r\n    50% { \r\n        box-shadow: 0 0 15px 