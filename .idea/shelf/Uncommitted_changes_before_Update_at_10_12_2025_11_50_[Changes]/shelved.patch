++<+>/* ----------------------------------- */\r\n/* 1. VARIABLES DE COLOR */\r\n/* ----------------------------------- */\r\n:root {\r\n    --color-blue-dark:#363960;\r\n    --color-blue-hard: #033D69;\r\n    --color-danger: #f15656;\r\n    --color-blue-soft: #2A88B3;\r\n    --color-green: #5CB85C;\r\n    --color-white: #FFFFFF;\r\n    --color-text-grey: #495057;\r\n    --color-border: #E9ECEF;\r\n    --color-transition1:#c3d6dc;\r\n    --color-transition2:#a7d1d9;\r\n    --color-fondo-overlay: rgba(0, 0, 0, 0.4); \r\n}\r\n\r\n/* ----------------------------------- */\r\n/* 2. BASE */\r\n/* ----------------------------------- */\r\n* {\r\n    box-sizing: border-box;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n\r\n\r\nbutton{\r\n    border: none;\r\n    background-color: white;\r\n    font-size: 1.1rem;\r\n}\r\nbody {\r\n    font-family: 'Poppins', sans-serif;\r\n    line-height: 1.6;\r\n    color: var(--color-text-grey);\r\n    background-color: var(--color-white);\r\n}\r\n\r\na {\r\n    text-decoration: none;\r\n    color: var(--color-blue-soft);\r\n}\r\n\r\nh1, h2, h3 {\r\n    color: var(--color-blue-hard);\r\n    margin-bottom: 0.5em;\r\n    line-height: 1.2;\r\n}\r\n\r\nstrong {\r\n    color: var(--color-blue-soft);\r\n}\r\n\r\n/* ----------------------------------- */\r\n/* 3. HEADER */\r\n/* ----------------------------------- */\r\n.header {\r\n    display: flex;\r\n    justify-content: space-between;\r\n    align-items: center;\r\n    padding: 15px 5%; \r\n    background-color: var(--color-white);\r\n    border-bottom: 1px solid var(--color-border);\r\n    position: sticky; \r\n    top: 0;          \r\n    z-index: 1000;  \r\n}\r\n\r\n.header__logo img {\r\n    height: 65px; \r\n    width: auto;\r\n    transition: height 0.3s;\r\n}\r\n\r\n/* ----------------------------------- */\r\n/* 4. NAV */\r\n/* ----------------------------------- */\r\n.nav {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 25px;\r\n}\r\n\r\n.nav__item {\r\n    font-weight: 500;\r\n    white-space: nowrap;\r\n    color: var(--color-text-grey); \r\n    transition: color 0.3s, border-bottom 0.3s;\r\n    border: none;\r\n    background-color: white;\r\n}\r\n\r\n.nav__item:hover {\r\n    color: var(--color-blue-soft); \r\n}\r\n\r\n.nav__item--active {\r\n    color: var(--color-blue-hard);\r\n    font-weight: 500;\r\n    border: none;\r\n    border-bottom: 2px solid var(--color-blue-soft);\r\n    background-color: white;\r\n}\r\n\r\n.nav__auth-group {\r\n    display: flex;\r\n    border-left: 1px solid var(--color-border);\r\n    padding-left: 20px;\r\n}\r\n\r\n.nav__auth-link {\r\n    font-size: 1em; \r\n    color: var(--color-blue-dark); \r\n    margin-left: 12px;\r\n    font-weight: 500;\r\n    border: none;\r\n    background-color: white;\r\n\r\n}\r\n\r\n.nav__auth-link:hover {\r\n    color: var(--color-blue-soft);\r\n}\r\n/* ----------------------------------- */\r\n/* HAMBURGUESA */\r\n/* ----------------------------------- */\r\n.nav__toggle, \r\n.nav__hamburger {\r\n    display: none;\r\n}\r\n\r\n@media (max-width: 1000px) {\r\n    .nav__hamburger {\r\n        display: flex;\r\n        flex-direction: column;\r\n        justify-content: space-around;\r\n        width: 30px;\r\n        height: 24px;\r\n        cursor: pointer;\r\n        z-index: 1001; \r\n        margin-left: 20px;\r\n    }\r\n\r\n    .nav__hamburger span {\r\n        display: block;\r\n        height: 3px;\r\n        width: 100%;\r\n        background: var(--color-text-grey);\r\n        border-radius: 3px;\r\n        transition: all 0.3s ease-in-out;\r\n    }\r\n\r\n    .nav {\r\n        display: none; \r\n        flex-direction: column;\r\n        position: absolute;\r\n        top: 100%; \r\n        left: 0;\r\n        width: 100%;\r\n        background-color: var(--color-white);\r\n        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);\r\n        padding: 10px 0;\r\n        z-index: 1000;\r\n        border-top: 1px solid var(--color-border);\r\n    }\r\n    \r\n    .nav__item {\r\n        width: 100%;\r\n        text-align: center;\r\n        padding: 12px 0;\r\n        border-bottom: 1px solid var(--color-border);\r\n    }\r\n\r\n    .nav__item--active {\r\n        border-bottom: none;\r\n    }\r\n\r\n    .nav__item:hover {\r\n        background-color: var(--color-border);\r\n        color: var(--color-blue-soft);\r\n    }\r\n\r\n    .nav__auth-group {\r\n        flex-direction: column;\r\n        border-left: none; \r\n        border-top: 1px solid var(--color-border);\r\n        padding: 10px 0;\r\n        margin-left: 0;\r\n        text-align: center;\r\n        width: 100%;\r\n    }\r\n    \r\n    .nav__auth-link {\r\n        padding: 8px 0;\r\n        margin: 5px auto;\r\n    }\r\n\r\n    .button {\r\n        width: 80%;\r\n        margin: 15px auto;\r\n        padding: 0;\r\n        height: 3.5em;\r\n    }\r\n\r\n\r\n    .nav__toggle:checked ~ .nav {\r\n        display: flex;\r\n    }\r\n    \r\n    .nav__toggle:checked ~ .nav__hamburger span:nth-child(1) {\r\n        transform: rotate(45deg) translate(6px, 6px);\r\n    }\r\n\r\n    .nav__toggle:checked ~ .nav__hamburger span:nth-child(2) {\r\n        opacity: 0;\r\n    }\r\n\r\n    .nav__toggle:checked ~ .nav__hamburger span:nth-child(3) {\r\n        transform: rotate(-45deg) translate(6px, -6px);\r\n    }\r\n\r\n\r\n}\r\n\r\n\r\n@media (min-width: 1001px) {\r\n    .nav {\r\n        gap: 15px; \r\n    }\r\n\r\n\r\n\r\n    .button {\r\n        display: flex;\r\n        margin-left: 20px;\r\n    }\r\n}\r\n\r\n\r\n.button {\r\n  display: flex;\r\n  height: 3em;\r\n  width: 160px;\r\n  align-items: center;\r\n  justify-content: center;\r\n  border-radius: 6px;\r\n  letter-spacing: 1px;\r\n  transition: all 0.25s linear;\r\n  cursor: pointer;\r\n  border: none;\r\n  background: var(--color-green);\r\n  color: var(--color-white);\r\n\r\n  font-family: 'Poppins', sans-serif;\r\n  font-weight: 600;\r\n  font-size: 0.9rem;\r\n  white-space: nowrap;\r\n}\r\n\r\n.button .wrap p {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 8px;\r\n  margin: 0;\r\n  position: relative;   \r\n}\r\n\r\n.button span {\r\n  position: absolute;\r\n  left: 0;\r\n  transition: opacity 0.2s ease;\r\n}\r\n\r\n.button .wrap p::before {\r\n  content: \"\";\r\n  display: inline-block;\r\n  width: 18px;\r\n  height: 1px;\r\n}\r\n\r\n.button:hover {\r\n  box-shadow: 0px 0px 5px var(--color-text-grey),\r\n              -9px -9px 33px #ffffff;\r\n}\r\n.table-flex{\r\n    display: flex;\r\n\r\n}\r\n.button span:nth-child(1) {\r\n  opacity: 1;\r\n}\r\n\r\n.button span:nth-child(2) {\r\n  opacity: 0;\r\n}\r\n\r\n.button:hover span:nth-child(1) {\r\n  opacity: 0;\r\n}\r\n\r\n.button:hover span:nth-child(2) {\r\n  opacity: 1;\r\n}\r\n\r\n\r\n.button-table {\r\n    display: flex;\r\n    height: 1.8rem;\r\n    min-width: 6rem;\r\n    text-align: center;\r\n    align-items: center;\r\n    justify-content: center;\r\n    border-radius: 6px;\r\n    letter-spacing: 1px;\r\n    transition: all 0.25s linear;\r\n    cursor: pointer;\r\n    border: none;\r\n    background: var(--color-green);\r\n    color: var(--color-white);\r\n    font-size: 0.9rem;\r\n}\r\n.button-table:hover {\r\n    box-shadow: 0px 0px 5px var(--color-text-grey),\r\n    -9px -9px 33px #ffffff;\r\n}\r\n\r\n\r\n/* ----------------------------------- */\r\n/* 5. VIDEO */\r\n/* ----------------------------------- */\r\n\r\n.video-background {\r\n    position: relative;\r\n    width: 100%;\r\n    height: 100vh;\r\n    overflow: hidden;\r\n}\r\n\r\n/* Video */\r\n#background-video {\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    width: 100%;\r\n    height: 100%;\r\n    object-fit: cover;\r\n    z-index: 1;\r\n}\r\n\r\n.video-overlay {\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    width: 100%;\r\n    height: 100%;\r\n    background: linear-gradient(\r\n        180deg,\r\n        rgba(0, 0, 0, 0.45) 0%,\r\n        rgba(0, 0, 0, 0.75) 100%\r\n    );\r\n    z-index: 2;\r\n}\r\n\r\n.content {\r\n    position: absolute;\r\n    top: 0;\r\n    left: 0;\r\n    width: 100%;\r\n    height: 100%;\r\n    display: flex;\r\n    flex-direction: column;\r\n    justify-content: center;\r\n    align-items: center;\r\n    text-align: center;\r\n    z-index: 3;\r\n    padding: 0 20px; \r\n}\r\n\r\n.content h1 {\r\n    font-size: 3.8em; \r\n    color: var(--color-white); \r\n    text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.9);\r\n    margin-bottom: 0.2em; \r\n    line-height: 1.1;\r\n}\r\n\r\n.content .subtitle {\r\n    font-size: 1.5em;\r\n    color: var(--color-transition1); \r\n    text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.7);\r\n    margin-bottom: 2em; \r\n    max-width: 800px; \r\n}\r\n\r\n.cta-buttons {\r\n    display: flex;\r\n    gap: 20px;\r\n    flex-wrap: wrap;\r\n    justify-content: center;\r\n}\r\n@keyframes slideInFromBottom {\r\n    0% {\r\n        opacity: 0;\r\n        transform: translateY(20px); \r\n    }\r\n    100% {\r\n        opacity: 1;\r\n        transform: translateY(0); \r\n    }\r\n}\r\n\r\n.cta-buttons .btn {\r\n    opacity: 0; \r\n    animation: slideInFromBottom 0.6s ease-out forwards;\r\n}\r\n\r\n.cta-buttons .btn:nth-child(1) {\r\n    animation-delay: 0.2s;\r\n}\r\n\r\n.cta-buttons .btn:nth-child(2) {\r\n    animation-delay: 0.4s; \r\n}\r\n\r\n.btn {\r\n    padding: 15px 35px;\r\n    font-size: 1.1em;\r\n    font-weight: bold;\r\n    text-decoration: none;\r\n    border-radius: 8px;\r\n    transition: background-color 0.3s, transform 0.2s;\r\n}\r\n\r\n.btn-primary-hero {\r\n    background-color: var(--color-blue-soft); \r\n    color: var(--color-white);\r\n}\r\n\r\n.btn-primary-hero:hover {\r\n    background-color: var(--color-blue-hard);\r\n    transform: translateY(-2px);\r\n}\r\n\r\n.btn-secondary-hero {\r\n    background-color: transparent;\r\n    color: var(--color-white);\r\n    border: 2px solid var(--color-white);\r\n}\r\n\r\n.btn-secondary-hero:hover {\r\n    background-color: rgba(255, 255, 255, 0.1);\r\n    transform: translateY(-2px);\r\n}\r\n\r\n@media (max-width: 992px) {\r\n    .content h1 {\r\n        font-size: 2.8em;\r\n    }\r\n    .content .subtitle {\r\n        font-size: 1.2em;\r\n    }\r\n    .cta-buttons {\r\n        flex-direction: column; \r\n    }\r\n    .btn {\r\n        padding: 12px 25px;\r\n        width: 100%; \r\n    }\r\n}\r\n\r\n@media (max-width: 576px) {\r\n    .content h1 {\r\n        font-size: 2em;\r\n    }\r\n}\r\n\r\n/* ----------------------------------- */\r\n/* 6. BOTONES */\r\n/* ----------------------------------- */\r\n.btn {\r\n    display: inline-block;\r\n    padding: 10px 20px;\r\n    border-radius: 4px;\r\n    font-weight: bold;\r\n    text-align: center;\r\n    transition: background-color 0.3s ease;\r\n}\r\n\r\n.btn--secondary {\r\n    background-color: var(--color-green);\r\n    color: var(--color-white);\r\n    border: 2px solid var(--color-green);\r\n}\r\n\r\n.btn--secondary:hover {\r\n    background-color: #4CAF50;\r\n    border-color: #4CAF50;\r\n}\r\n\r\n/* ----------------------------------- */\r\n/* 7. SERVICIOS */\r\n/* ----------------------------------- */\r\n.services {\r\n    padding: 70px 6%;\r\n    max-width: 1300px;\r\n    margin: 0 auto;\r\n    text-align: center;\r\n}\r\n\r\n.usuarios-admin {\r\n    padding: 70px 6%;\r\n    max-width: 1800px;\r\n    margin: 0 auto;\r\n    text-align: center;\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 1rem;\r\n\r\n}\r\n\r\n\r\n .button-especialidad{\r\n    display: flex;\r\n    flex-direction: column;\r\n    flex: 1;\r\n    width: 100%;\r\n     height: 100%;\r\n    padding: 0;\r\n    background: none;\r\n}\r\n.services__title {\r\n    font-size: 2.4rem;\r\n    margin-bottom: 50px;\r\n    font-weight: 600;\r\n}\r\n\r\n\r\n.services__card-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); \r\n    gap: 30px;\r\n}\r\n\r\n\r\n.card-title {\r\n    color: var(--color-blue-hard); \r\n    font-size: 1.6rem; \r\n    line-height: 1.2;\r\n    font-weight: 700;\r\n    margin-bottom: 0.4em;\r\n    transition: color 0.4s ease;\r\n}\r\n\r\n.small-desc {\r\n    font-size: 1em;\r\n    font-weight: 400;\r\n    line-height: 1.6em;\r\n    color: var(--color-text-grey);\r\n    \r\n}\r\n\r\n\r\n.card {\r\n    display: flex;\r\n    flex-direction: column;\r\n    justify-content: space-between;\r\n    text-align: left;\r\n    height: 100%; \r\n    max-width: none;\r\n    max-height: none;\r\n    margin: 0; \r\n    background-color: var(--color-white);\r\n    border-radius: 12px;\r\n    padding: 2em 1.5em; \r\n    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);\r\n    transition: all 0.4s ease;\r\n    border: 2px solid var(--color-border);\r\n    position: relative;\r\n    overflow: hidden;\r\n    z-index: 1;\r\n    width: 100%;\r\n}\r\n\r\n.go-corner {\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    position: absolute;\r\n    width: 2.5em;\r\n    height: 2.5em;\r\n    overflow: hidden;\r\n    top: -2px; \r\n    right: -2px;\r\n    background: var(--color-blue-soft);\r\n    border-radius: 0 10px 0 10px; \r\n    z-index: 2;\r\n}\r\n\r\n.go-star {\r\n    margin-top: 0;\r\n    margin-right: 0;\r\n    color: var(--color-white);\r\n    font-size: 1.2em;\r\n}\r\n\r\n\r\n.card:before {\r\n    content: none; \r\n}\r\n\r\n.card:hover {\r\n    box-shadow: 0 10px 30px rgba(42, 136, 179, 0.2); \r\n    transform: translateY(-5px); \r\n    border-color: var(--color-blue-soft); \r\n}\r\n\r\n.card:hover .small-desc {\r\n    transition: none;\r\n    color: var(--color-text-grey);\r\n}\r\n\r\n.card:hover .card-title {\r\n    transition: color 0.4s ease;\r\n    color: var(--color-blue-soft); \r\n}\r\n\r\n\r\n.btn--large {\r\n    padding: 18px 40px;\r\n    font-size: 1.2em;\r\n    border-radius: 10px;\r\n}\r\n\r\n/* ----------------------------------- */\r\n/* 8. GALERIA */\r\n/* ----------------------------------- */\r\n\r\n\r\n.seccion {\r\n    padding: 70px 6%;\r\n    max-width: 90%;\r\n    margin: 0 auto;\r\n    text-align: center;\r\n    \r\n}\r\n\r\n.seccion-titulo {\r\n    font-size: 2.4rem;\r\n    margin-bottom: 50px;\r\n    font-weight: 600;\r\n    color: var(--color-blue-hard);\r\n}\r\n\r\n.gal {\r\n    display: flex;\r\n    width: 100%;\r\n    height: 400px; \r\n    overflow: hidden; \r\n    border-radius: 12px; \r\n    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15); \r\n  }\r\n\r\n  .gal img{\r\n    width: 0px;\r\n    flex-grow: 1;\r\n    object-fit: cover;\r\n    opacity: .8;\r\n    transition: .5s ease;\r\n  }\r\n  .gal img:hover{\r\n    width: 300px;\r\n    opacity: 1;\r\n    filter: contrast(110%);\r\n\r\n  }\r\n  @media (max-width: 1024px) {\r\n    .gal {\r\n      height: 300px;\r\n    }\r\n    .gal img:hover {\r\n      width: 220px;\r\n    }\r\n  }\r\n\r\n  @media (max-width: 768px) {\r\n    .gal {\r\n      flex-direction: column;\r\n      height: auto;\r\n      gap: 4px;\r\n     \r\n    }\r\n    .gal img {\r\n      width: 100% ;\r\n      height: 200px;\r\n      flex-grow: unset;\r\n      opacity: 1;\r\n    }\r\n    .gal img:hover {\r\n      width: 100% ;\r\n    }\r\n  }\r\n\r\n  @media (max-width: 480px) {\r\n    .gal img {\r\n      height: 150px;\r\n    }\r\n  }\r\n\r\n/* ----------------------------------- */\r\n/* 9. FILOSOFÍA Y COMPROMISO */\r\n/* ----------------------------------- */\r\n.philosophy {\r\n    padding: 70px 6%;\r\n    background-color: var(--color-border); \r\n    text-align: center;\r\n}\r\n\r\n.philosophy__container {\r\n    max-width: 1100px;\r\n    margin: 0 auto;\r\n}\r\n\r\n.philosophy__title {\r\n    font-size: 2.4rem;\r\n    margin-bottom: 50px;\r\n    font-weight: 700;\r\n    color: var(--color-blue-hard);\r\n}\r\n\r\n.philosophy__content {\r\n    display: flex;\r\n    gap: 30px;\r\n    margin-bottom: 50px;\r\n    text-align: left;\r\n}\r\n\r\n.philosophy__card {\r\n    flex: 1;\r\n    background-color: var(--color-white);\r\n    padding: 30px;\r\n    border-radius: 12px;\r\n    box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);\r\n    transition: transform 0.3s ease;\r\n}\r\n\r\n.philosophy__card h3 {\r\n    color: var(--color-blue-soft);\r\n    font-size: 1.6rem;\r\n    margin-top: 0;\r\n    margin-bottom: 15px;\r\n    border-bottom: 2px solid var(--color-border);\r\n    padding-bottom: 10px;\r\n}\r\n\r\n.philosophy__card p {\r\n    font-size: 1.1em;\r\n    color: var(--color-text-grey);\r\n}\r\n\r\n.philosophy__card:hover {\r\n    transform: translateY(-5px); \r\n}\r\n\r\n.policy-links {\r\n    padding-top: 20px;\r\n    border-top: 1px solid var(--color-text-grey);\r\n}\r\n\r\n.policy-links h4 {\r\n    font-size: 1.3rem;\r\n    color: var(--color-blue-dark);\r\n    margin-bottom: 20px;\r\n}\r\n\r\n.btn-policy {\r\n    display: inline-block;\r\n    padding: 10px 20px;\r\n    margin: 5px 10px;\r\n    background-color: var(--color-blue-hard);\r\n    color: var(--color-white);\r\n    border-radius: 6px;\r\n    font-weight: 600;\r\n    transition: background-color 0.3s;\r\n}\r\n\r\n.btn-policy:hover {\r\n    background-color: var(--color-blue-soft);\r\n}\r\n\r\n@media (max-width: 768px) {\r\n    .philosophy__content {\r\n        flex-direction: column; \r\n    }\r\n    .philosophy__card {\r\n        margin-bottom: 20px;\r\n    }\r\n}\r\n\r\n\r\n/* ----------------------------------- */\r\n/* 10. SECCION FINAL */\r\n/* ----------------------------------- */\r\n.cta-section {\r\n    background-color: var(--color-blue-hard);\r\n    color: var(--color-white);\r\n    text-align: center;\r\n    padding: 80px 5%; \r\n}\r\n\r\n.cta-icon {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    margin-bottom: 20px; \r\n}\r\n\r\n.cta-icon span {\r\n    display: block; \r\n    line-height: 1; \r\n    animation: glow 2.5s infinite ease-in-out; \r\n    border-radius: 50%; \r\n    padding: 10px; \r\n}\r\n\r\n.cta-icon span img {\r\n    height: 90px; \r\n    width: auto;\r\n    display: block; \r\n    object-fit: contain; \r\n}\r\n\r\n@keyframes glow {\r\n    0% { \r\n        box-shadow: 0 0 8px rgba(255, 255, 255, 0.4), 0 0 15px var(--color-green); \r\n        transform: scale(1);\r\n    }\r\n    50% { \r\n        box-shadow: 0 0 15px rgba(255, 255, 255, 0.7), 0 0 30px var(--color-green); \r\n        transform: scale(1.03); /* Ligeramente más grande */\r\n    }\r\n    100% { \r\n        box-shadow: 0 0 8px rgba(255, 255, 255, 0.4), 0 0 15px var(--color-green); \r\n        transform: scale(1);\r\n    }\r\n}\r\n\r\n.cta-section__title {\r\n    color: var(--color-white);\r\n    font-size: 2.8rem; \r\n    margin-bottom: 15px;\r\n    font-weight: 700;\r\n}\r\n\r\n.cta-section__subtitle {\r\n    font-size: 1.2rem;\r\n    color: var(--color-transition1); \r\n    margin-bottom: 40px;\r\n    max-width: 700px;\r\n    margin-left: auto;\r\n    margin-right: auto;\r\n}\r\n\r\n.stepper-wrapper {\r\n    margin-top: auto;\r\n    display: flex;\r\n    justify-content: space-between;\r\n    margin-bottom: 20px;\r\n}\r\n.stepper-item {\r\n    position: relative;\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n    flex: 1;\r\n\r\n    @media (max-width: 768px) {\r\n        font-size: 12px;\r\n    }\r\n}\r\n\r\n.stepper-item::before {\r\n    position: absolute;\r\n    content: \"\";\r\n    border-bottom: 2px solid #ccc;\r\n    width: 100%;\r\n    top: 20px;\r\n    left: -50%;\r\n    z-index: 2;\r\n}\r\n\r\n.stepper-item::after {\r\n    position: absolute;\r\n    content: \"\";\r\n    border-bottom: 2px solid #ccc;\r\n    width: 100%;\r\n    top: 20px;\r\n    left: 50%;\r\n    z-index: 2;\r\n}\r\n\r\n.stepper-item .step-counter {\r\n    position: relative;\r\n    z-index: 5;\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    width: 40px;\r\n    height: 40px;\r\n    border-radius: 50%;\r\n    background: #ccc;\r\n    margin-bottom: 6px;\r\n}\r\n\r\n.stepper-item.active {\r\n    font-weight: bold;\r\n}\r\n\r\n.stepper-item.completed .step-counter {\r\n    background-color: var(--color-blue-soft);\r\n    color: white;\r\n}\r\n\r\n.stepper-item.completed::after {\r\n    position: absolute;\r\n    content: \"\";\r\n    border-bottom: 2px solid var(--color-blue-soft);\r\n    width: 100%;\r\n    top: 20px;\r\n    left: 50%;\r\n    z-index: 3;\r\n}\r\n\r\n.stepper-item:first-child::before {\r\n    content: none;\r\n}\r\n.stepper-item:last-child::after {\r\n    content: none;\r\n}\r\n\r\n.tabla{\r\n    width: 100%;\r\n    border-collapse: separate;\r\n    border-spacing: 0;\r\n    border-radius: 6px;\r\n    overflow: hidden;\r\n    height: 7rem;\r\n    border: 1px solid var(--color-blue-soft);\r\n    table-layout: fixed;\r\n\r\n}\r\n\r\n\r\n\r\n.tabla th{\r\n    padding: 0.6rem;\r\n    background-color: var(--color-blue-soft);\r\n    color: white;\r\n    border-bottom: var(--color-white);\r\n    overflow-wrap: break-word;\r\n\r\n}\r\n.tabla td{\r\n    padding: 0.6rem;\r\n    overflow-wrap: break-word;\r\n}\r\n\r\n.tabla td button {\r\n    margin: 0 auto;\r\n    display: block;\r\n}\r\n\r\n\r\n.tabla tr:nth-child(even) {\r\n    background: var(--color-white);\r\n}\r\n\r\n.tabla tr:nth-child(odd) {\r\n    background: var(--color-border);\r\n}\r\n.button-table:hover {\r\n    box-shadow: 0px 0px 5px var(--color-text-grey),\r\n    0px 0px 15px #ffffff;\r\n}\r\n.div__button-table{\r\n    display: flex;\r\n    flex-direction: row;\r\n    padding: 2rem 0;\r\n}\r\n.div__button-container{\r\n    display: grid;\r\n    grid-template-columns: 1fr 8fr 1fr;\r\n}\r\n\r\n.grid-1{\r\n    order: 3;\r\n}\r\n.grid-2{\r\n    order: 2;\r\n}\r\n.grid-3{\r\n    order: 1;\r\n}\r\n.input-date{\r\n    width: 30%;\r\n    padding: 1rem;\r\n    font-size: 20px;\r\n    text-align: center;\r\n    font-family: Poppins;\r\n    border-radius: 20px;\r\n}\r\n.button__back{\r\n    background-color: var(--color-blue-hard);\r\n    padding:0  15px;\r\n}\r\n\r\n.button__danger{\r\n    background-color: var(--color-danger);\r\n    padding: 0 7px;\r\n}\r\n\r\n.card-time-cloud {\r\n    position: relative;\r\n    border-radius: 1em;\r\n    width: 17.5em;\r\n    height: 8em;\r\n    z-index: 2;\r\n    border: solid 0.15em var(--color1);\r\n    transition: 0.5s all ease-in-out;\r\n    box-shadow: 0em 0em rgb(0, 0, 0, 0.25);\r\n    overflow: hidden;\r\n    --color1: rgb(237, 120, 42);\r\n    --skycolor: #ffffff;\r\n}\r\n\r\n.card-time-cloud-front {\r\n    width: 20em;\r\n    height: 12.5em;\r\n    background: rgb(228, 228, 228);\r\n    border-radius: 1em;\r\n    position: absolute;\r\n    z-index: 2;\r\n    top: 95%;\r\n    left: 50%;\r\n    transform: translate(-50%, -50%);\r\n    transition: 0.5s all ease-in-out;\r\n}\r\n\r\n.card-time-cloud-back {\r\n    width: 20em;\r\n    height: 17.5em;\r\n    background: var(--skycolor);\r\n    border-radius: 1em;\r\n    position: absolute;\r\n    z-index: 1;\r\n    top: 57.5%;\r\n    left: 50%;\r\n    transform: translate(-50%, -50%);\r\n    transition: 0.5s all ease-in-out;\r\n}\r\n\r\n.card-time-cloud:hover {\r\n    margin-bottom: 1em;\r\n    box-shadow: 0em 1em rgb(237, 120, 42, 0.5);\r\n}\r\n\r\n.card-time-cloud:hover .card-time-cloud-front {\r\n    top: 105%;\r\n}\r\n\r\n.card-time-cloud-back svg {\r\n    position: absolute;\r\n    z-index: 1;\r\n    top: -16.45em;\r\n    left: -7.5em;\r\n    width: 25em;\r\n    height: auto;\r\n    opacity: 100%;\r\n    animation: rotate-cloud 15s linear infinite;\r\n}\r\n\r\n.card-time-cloud-back svg:nth-child(2) {\r\n    animation: rotate-cloud 15s linear infinite 1s;\r\n    opacity: 50%;\r\n}\r\n\r\n@keyframes rotate-cloud {\r\n    0% {\r\n        transform: rotate(0deg);\r\n    }\r\n    100% {\r\n        transform: rotate(360deg);\r\n    }\r\n}\r\n\r\n.card-time-cloud-day {\r\n    color: var(--color1);\r\n    position: absolute;\r\n    z-index: 3;\r\n    top: 1.25em;\r\n    left: 0.5em;\r\n    font-size: 1.5em;\r\n    font-weight: bold;\r\n    transition: 0.5s all ease-in-out;\r\n}\r\n\r\n.card-time-cloud-day-number {\r\n    color: var(--color1);\r\n    position: absolute;\r\n    z-index: 3;\r\n    top: 3em;\r\n    left: 0.65em;\r\n    font-size: 1.25em;\r\n    transition: 0.5s all ease-in-out;\r\n    font-weight: 500;\r\n}\r\n\r\n.card-time-cloud-hour {\r\n    color: var(--color1);\r\n    position: absolute;\r\n    z-index: 3;\r\n    top: 1.25em;\r\n    right: 0.5em;\r\n    font-size: 1.5em;\r\n    font-weight: bold;\r\n    transition: 0.5s all ease-in-out;\r\n}\r\n\r\n.card-time-cloud:hover {\r\n    height: 15em;\r\n}\r\n\r\n.card-time-cloud:hover .card-time-cloud-day {\r\n    top: 2.25em;\r\n}\r\n\r\n.card-time-cloud:hover .card-time-cloud-day-number {\r\n    top: 4em;\r\n}\r\n\r\n.card-time-cloud:hover .card-time-cloud-hour {\r\n    top: 1em;\r\n    font-size: 3em;\r\n}\r\n\r\n.card-time-cloud-icon svg {\r\n    position: absolute;\r\n    z-index: 4;\r\n    top: 4em;\r\n    right: 0.6em;\r\n    transform: rotate(0deg);\r\n    width: 1.5em;\r\n    height: auto;\r\n    transition: 0.5s all ease-in-out;\r\n}\r\n\r\n.card-time-cloud:hover .card-time-cloud-icon svg {\r\n    top: 7.25em;\r\n    right: -1.75em;\r\n    width: 7.5em;\r\n    height: auto;\r\n    transform: rotate(-35deg);\r\n}\r\n.card-time-cloud:active {\r\n    transition: 0.25s all ease-in-out;\r\n    transform: scale(0.95);\r\n}\r\n\r\n.card-time-cloud:active .card-time-cloud-front {\r\n    transition: 0.25s all ease-in-out;\r\n    top: 120%;\r\n    background-color: var(--color1);\r\n}\r\n\r\n.card-time-cloud:active .card-time-cloud-icon svg {\r\n    transition: 0.25s all ease-in-out;\r\n    top: 8em;\r\n    transform: rotate(-25deg);\r\n    stroke: #4a4b55;\r\n}\r\n\r\n.button-time {\r\n    background-color: #fff;\r\n    border: 1px solid var(--color-blue-soft);\r\n    padding: 5px;\r\n    position: relative;\r\n    width: 100%;\r\n    height: 2em;\r\n    transition: 0.5s;\r\n    font-size: 27px;\r\n    border-radius: 0.4em;\r\n\r\n}\r\n.h2-day{\r\n    margin: 2rem;\r\n}\r\n.button-time p {\r\n    position: absolute;\r\n    top: 0.4em;\r\n    left: 50%;\r\n    transform: translateX(-50%);\r\n    margin: 0;\r\n    padding: 0;\r\n    transition: .5s;\r\n    color: var(--color-blue-soft);\r\n}\r\n\r\n.button-time svg {\r\n    position: absolute;\r\n    top: 0.45em;\r\n    right: 0.5em;\r\n    margin: 0;\r\n    padding: 0;\r\n    opacity: 0;\r\n    transition: 0.5s;\r\n    height: 1em;\r\n    fill: #fff\r\n}\r\n\r\n.button-time:hover p {\r\n    left: 0.5em;\r\n    transform: translateX(0);\r\n    color: #fff;\r\n}\r\n.button-time:hover svg {\r\n    opacity: 1;\r\n}\r\n\r\n.button-time:hover {\r\n    background-color: var(--color-blue-soft);\r\n}\r\n\r\n.task {\r\n    position: relative;\r\n\r\n    color: #2e2e2f;\r\n    cursor: move;\r\n    background-color: #fff;\r\n    padding: 1rem;\r\n    border-radius: 8px;\r\n    box-shadow: rgba(99, 99, 99, 0.1) 0px 2px 8px 0px;\r\n    margin-bottom: 1rem;\r\n    border: 3px dashed transparent;\r\n    width:50%;\r\n    overflow-wrap: break-word;\r\n}\r\n\r\n.task h2{\r\n    color: var(--color-blue-hard);\r\n}\r\n\r\n.task:hover {\r\n    box-shadow: rgba(99, 99, 99, 0.3) 0px 2px 8px 0px;\r\n\r\n}\r\n\r\n.task p {\r\n    font-size: 20px;\r\n    margin: 1rem 0 0 0;\r\n}\r\n\r\n.tag {\r\n    border-radius: 100px;\r\n    padding: 4px 13px;\r\n    font-size: 12px;\r\n    color: #ffffff;\r\n    background-color: var(--color-blue-hard);\r\n}\r\n\r\n.tags {\r\n    width: 100%;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n    margin-bottom: 1rem;\r\n}\r\n\r\n.options {\r\n    background: transparent;\r\n    border: 0;\r\n    color: #c4cad3;\r\n    font-size: 17px;\r\n}\r\n\r\n.options svg {\r\n    fill: #9fa4aa;\r\n    width: 20px;\r\n}\r\n\r\n.stats {\r\n    position: relative;\r\n    width: 100%;\r\n    color: #9fa4aa;\r\n    font-size: 12px;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: space-between;\r\n}\r\n\r\n.stats div {\r\n    margin-right: 1rem;\r\n    height: 20px;\r\n    dis