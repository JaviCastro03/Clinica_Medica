al\r\n\r\n        //Content\r\n        $mail->isHTML(true);                                  //Set email format to HTML\r\n        $mail->Subject = $asunto;\r\n        $mail->Body = $mensaje;\r\n\r\n        $mail->CharSet = 'UTF-8';          // Asegura que los acentos y eñes se muestren correctamente\r\n        $mail->Encoding = 'base64';\r\n\r\n        $mail->send();\r\n        return true;\r\n    } catch (Exception $e) {\r\n        return false;\r\n\r\n    }\r\n\r\n\r\n}
