@@ -0,0 +1,1520 @@
+/* ----------------------------------- */
+/* 1. VARIABLES DE COLOR */
+/* ----------------------------------- */
+:root {
+    --color-blue-dark:#363960;
+    --color-blue-hard: #033D69;
+    --color-danger: #f15656;
+    --color-blue-soft: #2A88B3;
+    --color-green: #5CB85C;
+    --color-white: #FFFFFF;
+    --color-text-grey: #495057;
+    --color-border: #E9ECEF;
+    --color-transition1:#c3d6dc;
+    --color-transition2:#a7d1d9;
+    --color-fondo-overlay: rgba(0, 0, 0, 0.4); 
+}
+
+/* ----------------------------------- */
+/* 2. BASE */
+/* ----------------------------------- */
+* {
+    box-sizing: border-box;
+    margin: 0;
+    padding: 0;
+}
+
+
+button{
+    border: none;
+    background-color: white;
+    font-size: 1.1rem;
+}
+body {
+    font-family: 'Poppins', sans-serif;
+    line-height: 1.6;
+    color: var(--color-text-grey);
+    background-color: var(--color-white);
+}
+
+a {
+    text-decoration: none;
+    color: var(--color-blue-soft);
+}
+
+h1, h2, h3 {
+    color: var(--color-blue-hard);
+    margin-bottom: 0.5em;
+    line-height: 1.2;
+}
+
+strong {
+    color: var(--color-blue-soft);
+}
+
+/* ----------------------------------- */
+/* 3. HEADER */
+/* ----------------------------------- */
+.header {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    padding: 15px 5%; 
+    background-color: var(--color-white);
+    border-bottom: 1px solid var(--color-border);
+    position: sticky; 
+    top: 0;          
+    z-index: 1000;  
+}
+
+.header__logo img {
+    height: 65px; 
+    width: auto;
+    transition: height 0.3s;
+}
+
+/* ----------------------------------- */
+/* 4. NAV */
+/* ----------------------------------- */
+.nav {
+    display: flex;
+    align-items: center;
+    gap: 25px;
+}
+
+.nav__item {
+    font-weight: 500;
+    white-space: nowrap;
+    color: var(--color-text-grey); 
+    transition: color 0.3s, border-bottom 0.3s;
+    border: none;
+    background-color: white;
+}
+
+.nav__item:hover {
+    color: var(--color-blue-soft); 
+}
+
+.nav__item--active {
+    color: var(--color-blue-hard);
+    font-weight: 500;
+    border: none;
+    border-bottom: 2px solid var(--color-blue-soft);
+    background-color: white;
+}
+
+.nav__auth-group {
+    display: flex;
+    border-left: 1px solid var(--color-border);
+    padding-left: 20px;
+}
+
+.nav__auth-link {
+    font-size: 1em; 
+    color: var(--color-blue-dark); 
+    margin-left: 12px;
+    font-weight: 500;
+    border: none;
+    background-color: white;
+
+}
+
+.nav__auth-link:hover {
+    color: var(--color-blue-soft);
+}
+/* ----------------------------------- */
+/* HAMBURGUESA */
+/* ----------------------------------- */
+.nav__toggle, 
+.nav__hamburger {
+    display: none;
+}
+
+@media (max-width: 1000px) {
+    .nav__hamburger {
+        display: flex;
+        flex-direction: column;
+        justify-content: space-around;
+        width: 30px;
+        height: 24px;
+        cursor: pointer;
+        z-index: 1001; 
+        margin-left: 20px;
+    }
+
+    .nav__hamburger span {
+        display: block;
+        height: 3px;
+        width: 100%;
+        background: var(--color-text-grey);
+        border-radius: 3px;
+        transition: all 0.3s ease-in-out;
+    }
+
+    .nav {
+        display: none; 
+        flex-direction: column;
+        position: absolute;
+        top: 100%; 
+        left: 0;
+        width: 100%;
+        background-color: var(--color-white);
+        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
+        padding: 10px 0;
+        z-index: 1000;
+        border-top: 1px solid var(--color-border);
+    }
+    
+    .nav__item {
+        width: 100%;
+        text-align: center;
+        padding: 12px 0;
+        border-bottom: 1px solid var(--color-border);
+    }
+
+    .nav__item--active {
+        border-bottom: none;
+    }
+
+    .nav__item:hover {
+        background-color: var(--color-border);
+        color: var(--color-blue-soft);
+    }
+
+    .nav__auth-group {
+        flex-direction: column;
+        border-left: none; 
+        border-top: 1px solid var(--color-border);
+        padding: 10px 0;
+        margin-left: 0;
+        text-align: center;
+        width: 100%;
+    }
+    
+    .nav__auth-link {
+        padding: 8px 0;
+        margin: 5px auto;
+    }
+
+    .button {
+        width: 80%;
+        margin: 15px auto;
+        padding: 0;
+        height: 3.5em;
+    }
+
+
+    .nav__toggle:checked ~ .nav {
+        display: flex;
+    }
+    
+    .nav__toggle:checked ~ .nav__hamburger span:nth-child(1) {
+        transform: rotate(45deg) translate(6px, 6px);
+    }
+
+    .nav__toggle:checked ~ .nav__hamburger span:nth-child(2) {
+        opacity: 0;
+    }
+
+    .nav__toggle:checked ~ .nav__hamburger span:nth-child(3) {
+        transform: rotate(-45deg) translate(6px, -6px);
+    }
+
+
+}
+
+
+@media (min-width: 1001px) {
+    .nav {
+        gap: 15px; 
+    }
+
+
+
+    .button {
+        display: flex;
+        margin-left: 20px;
+    }
+}
+
+
+.button {
+  display: flex;
+  height: 3em;
+  width: 160px;
+  align-items: center;
+  justify-content: center;
+  border-radius: 6px;
+  letter-spacing: 1px;
+  transition: all 0.25s linear;
+  cursor: pointer;
+  border: none;
+  background: var(--color-green);
+  color: var(--color-white);
+
+  font-family: 'Poppins', sans-serif;
+  font-weight: 600;
+  font-size: 0.9rem;
+  white-space: nowrap;
+}
+
+.button .wrap p {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  margin: 0;
+  position: relative;   
+}
+
+.button span {
+  position: absolute;
+  left: 0;
+  transition: opacity 0.2s ease;
+}
+
+.button .wrap p::before {
+  content: "";
+  display: inline-block;
+  width: 18px;
+  height: 1px;
+}
+
+.button:hover {
+  box-shadow: 0px 0px 5px var(--color-text-grey),
+              -9px -9px 33px #ffffff;
+}
+.table-flex{
+    display: flex;
+
+}
+.button span:nth-child(1) {
+  opacity: 1;
+}
+
+.button span:nth-child(2) {
+  opacity: 0;
+}
+
+.button:hover span:nth-child(1) {
+  opacity: 0;
+}
+
+.button:hover span:nth-child(2) {
+  opacity: 1;
+}
+
+
+.button-table {
+    display: flex;
+    height: 1.8rem;
+    min-width: 6rem;
+    text-align: center;
+    align-items: center;
+    justify-content: center;
+    border-radius: 6px;
+    letter-spacing: 1px;
+    transition: all 0.25s linear;
+    cursor: pointer;
+    border: none;
+    background: var(--color-green);
+    color: var(--color-white);
